<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!--@inject-all head > meta[property], head > meta[name^="twitter:"], head > link[rel="canonical"]-->
<meta name="description" content="Stay connected with GhostHeart: verified profiles and email updates.">
<title>Stay Connected | GhostHeart</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Permanent+Marker&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/loud/loud.css">
<style>
.shero{position:relative;padding:150px clamp(16px,4vw,48px) 80px;overflow:hidden;isolation:isolate;background:var(--blood);color:var(--void)}
.shero .giant{position:absolute;z-index:-1;left:0;bottom:-4vw;font-size:26vw;color:transparent;-webkit-text-stroke:3px rgba(5,5,5,.22);white-space:nowrap;animation:slide 40s linear infinite}
.shero h1{font-size:clamp(80px,13vw,220px);margin-top:18px}
.shero h1 span{color:var(--bone);text-shadow:6px 6px 0 var(--void)}
.shero .tag{font-weight:700;max-width:620px}
.socials{display:grid;grid-template-columns:repeat(4,1fr);border:4px solid var(--void);margin-top:30px}
@media(max-width:800px){.socials{grid-template-columns:repeat(2,1fr)}}
.socials a{display:flex;flex-direction:column;gap:6px;padding:28px 20px;border-right:4px solid var(--void);background:var(--void);color:var(--bone);transition:.12s}
.socials a:last-child{border-right:none}
@media(max-width:800px){.socials a:nth-child(2){border-right:none}.socials a:nth-child(-n+2){border-bottom:4px solid var(--blood)}}
.socials b{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:clamp(32px,3.6vw,54px);text-transform:uppercase;line-height:.9}
.socials small{font-weight:700;letter-spacing:.16em;font-size:11px;color:var(--ash);text-transform:uppercase}
.socials a:hover{background:var(--bone);color:var(--void)}
.join{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(24px,4vw,60px);align-items:start}
@media(max-width:900px){.join{grid-template-columns:1fr}}
.join .big-join{font-size:clamp(64px,9vw,150px)}
.join .big-join span{color:var(--blood)}
.join .why{list-style:none;margin:26px 0;display:grid;gap:12px}
.join .why li{font-size:clamp(18px,1.8vw,22px);padding-left:34px;position:relative}
.join .why li::before{content:"✶";position:absolute;left:0;color:var(--blood)}
.join .fine{color:var(--ash);font-size:14px}
.form{background:#0e0b0b;color:var(--bone);border:3px solid var(--blood);padding:clamp(24px,3vw,40px);box-shadow:14px 14px 0 var(--blood)}
.form label{display:block;font-weight:700;letter-spacing:.18em;font-size:12px;text-transform:uppercase;margin-bottom:10px}
.form .row{display:flex;flex-wrap:wrap;gap:10px}
.form input{flex:1 1 220px;min-width:0;border:3px solid var(--void);background:#fff;color:var(--void);font:700 18px "Space Grotesk",sans-serif;padding:14px}
.form button{font-family:Anton,Impact,sans-serif;font-size:22px;text-transform:uppercase;background:var(--blood);color:#fff;padding:14px 22px;border:3px solid var(--blood)}
.form button:disabled,.form input:disabled{opacity:.55;cursor:not-allowed}
.form p{margin-top:14px;font-size:14px}
.form .pv{margin-top:14px;border:2px dashed var(--blood);padding:10px 12px;font-weight:700;font-size:13px}
.start{background:#0e0b0b;color:var(--bone);border-top:6px solid var(--blood)}
.start .door h3{font-size:clamp(34px,3.4vw,56px);overflow-wrap:anywhere}
.form h2{font-family:Anton,Impact,sans-serif;font-weight:400;text-transform:uppercase;font-size:clamp(32px,3vw,48px);line-height:.95}
.form p{font-size:15px;margin-top:8px}
.form .g-form-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:6px}
.form label{margin-top:14px}
.start .door-grid{grid-template-columns:repeat(4,1fr)}
@media(max-width:900px){.start .door-grid{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.start .door-grid{grid-template-columns:1fr}}
.sitefoot{display:block;padding:50px max(16px,4vw) 110px;border-top:4px solid var(--blood);background:var(--void);color:var(--bone);text-transform:none;letter-spacing:0;font-size:15px}
.sitefoot .fcols{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:30px}
@media(max-width:800px){.sitefoot .fcols{grid-template-columns:1fr 1fr}}
.sitefoot b{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:34px}.sitefoot b i{font-style:normal;color:var(--blood)}
.sitefoot p{color:var(--ash);margin-top:8px}
.sitefoot nav{display:flex;flex-direction:column;gap:8px}
.sitefoot nav span{font-weight:700;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--ash)}
.sitefoot nav a:hover{color:var(--hot)}
.sitefoot .fcopy{margin-top:34px;font-size:12px;letter-spacing:.15em;text-transform:uppercase}
/* Keep the existing email form within the opening content. */
.shero{padding-bottom:36px}
.shero h1{font-size:clamp(42px,5vw,68px);line-height:1.08}
.shero .tag{font-size:18px;line-height:1.5;margin:16px 0}
.shero .form{max-width:760px;margin:24px 0 36px;padding:20px;box-shadow:6px 6px 0 var(--blood)}
.shero .form h2{font-size:28px;line-height:1.2}
.shero .form p{font-size:15px;line-height:1.5}
.join{grid-template-columns:1fr}
#email-signup-title{scroll-margin-top:calc(var(--hdr,110px) + 24px)}
.email-entry:focus-visible{outline:3px solid currentColor;outline-offset:5px}
</style>
</head>
<body>
<!--@inject header.ghx-header-->
<main id="main-content">

<header class="shero">
  <div class="giant display">STAY CONNECTED STAY CONNECTED</div>
  <span class="kicker bone">✶ Stay Connected</span>
  <h1 class="display">Keep the<br><span>Heart Close.</span></h1>
  <p class="tag">New music, stories and films. Follow the verified profiles, or get email updates below.</p>
  <div class="form"><!--@inject div.g-wrap:has(> #email-signup-title)--></div>
  <div class="socials">
    <a href="https://www.youtube.com/@GhostHeart-M95RTK"><small>Films &amp; music videos</small><b>YouTube ↗</b></a>
    <a href="https://www.tiktok.com/@ghosthearted1"><small>Shorts &amp; clips</small><b>TikTok ↗</b></a>
    <a href="https://www.instagram.com/ghostheart131517/"><small>Art &amp; quotes</small><b>Instagram ↗</b></a>
    <a href="https://open.spotify.com/artist/68OskMXP10WmzJPexLzRc7"><small>Every song</small><b>Spotify ↗</b></a>
  </div>
</header>

<section>
  <div class="join">
    <div>
      <p class="display big-join">Join the<br><span>Heart Rebellion.</span></p>
      <ul class="why">
        <li>Read new chapters and the stories behind the music.</li>
        <li>See next-album details when the title, cover and timing are confirmed.</li>
        <li>Hear about THE WORLD IS WATCHING when the pilot has confirmed details.</li>
      </ul>
      <p class="fine">Free and optional. Unsubscribe anytime. The music, mission and help stay open to everyone. No event date, early access, exclusive content or personal reply is promised.</p>
    </div>

  </div>
</section>

<section class="start">
  <div class="label"><span>Start with what is public now</span><span class="num">✶</span></div>
  <div class="door-grid">
    <a class="door" href="/GhostHeart_Story.html"><span class="n">01</span><div><h3>Enter<br>My World</h3><p>The story</p></div></a>
    <a class="door" href="/music/#listen"><span class="n">02</span><div><h3>The<br>Awakening</h3><p>Eight songs</p></div></a>
    <a class="door" href="/music/#listen"><span class="n">03</span><div><h3>You're<br>Not God</h3><p>Three songs</p></div></a>
    <a class="door" href="/GhostHeart_Resources.html"><span class="n">04</span><div><h3>Help &amp;<br>Resources</h3><p>Real help</p></div></a>
  </div>
</section>

</main>
<footer class="sitefoot">
  <div class="fcols">
    <div><b>GHOST<i>HEART</i></b><p>Real stories. Real people. Same heart.</p></div>
    <nav aria-label="Listen and watch"><span>Listen &amp; watch</span><a href="/music/">Music</a><a href="/GhostHeart_Videos.html">Films</a><a href="/live/">Live</a></nav>
    <nav aria-label="Read"><span>Read</span><a href="/GhostHeart_Story.html">Enter My World</a><a href="/journal/">Blog</a></nav>
    <nav aria-label="Stay"><span>Stay</span><a href="/vault/">The Vault</a><a href="/follow/">Stay Connected</a><a href="/GhostHeart_Resources.html">Help &amp; Resources</a><a href="/GhostHeart_Privacy.html">Privacy</a></nav>
  </div>
  <p class="fcopy">© 2026 GhostHeart Studios</p>
</footer>

<script src="/assets/shared/ghostheart-world.js"></script>
<script src="/assets/loud/loud.js"></script>
</body>
</html>
