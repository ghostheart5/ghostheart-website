<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!--@inject-all head > meta[property], head > meta[name^="twitter:"], head > link[rel="canonical"]-->
<meta name="description" content="GhostHeart Sunday Lives: every Sunday at 10 a.m. Central on TikTok.">
<title>Lives | GhostHeart</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Permanent+Marker&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/loud/loud.css">
<style>
/* LIVES & READINGS CLEANUP 2026-11-01: one clear page, no pilot hero */
.lr-hero{background:var(--void);padding:clamp(110px,12vw,150px) clamp(16px,4vw,48px) clamp(28px,4vw,48px);border-bottom:6px solid var(--blood)}
.lr-hero h1{font-size:clamp(56px,8vw,120px);margin-top:12px}
.lr-hero h1 span{color:var(--blood)}
.lr-hero .lead{font-size:clamp(18px,2vw,22px);font-weight:700;max-width:640px;margin-top:14px;color:#d8d4cc}
.lr-sec{padding:clamp(28px,4vw,56px) clamp(16px,4vw,48px)}
.lr-sec h2{font-size:clamp(40px,5vw,72px)}
.lr-lives{background:var(--bone);color:var(--void)}
.lr-next{display:inline-block;background:var(--void);color:var(--bone);font-weight:700;font-size:12px;letter-spacing:.18em;text-transform:uppercase;padding:8px 12px}
.lr-lives h2#live-status-title{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:clamp(30px,4vw,56px);text-transform:uppercase;line-height:.95;margin:14px 0 6px}
.lr-lives .topic{font-weight:700;font-size:clamp(18px,2vw,22px);color:var(--blood)}
.lr-list{list-style:none;margin:22px 0 0;padding:0;border-top:3px solid var(--void);max-width:760px}
.lr-list li{display:grid;grid-template-columns:minmax(120px,180px) 1fr;gap:14px;padding:12px 0;border-bottom:2px solid rgba(0,0,0,.15);font-size:17px}
.lr-list li[hidden]{display:none}
.lr-list li b{font-weight:700}
@media(max-width:600px){.lr-list li{grid-template-columns:108px 1fr;gap:10px}}
.lr-small{font-size:16px;margin-top:14px;max-width:640px}
.lr-small a{color:var(--blood);text-decoration:underline}
.lr-read{background:var(--void);color:var(--bone)}
.lr-card{border:3px solid var(--bone);padding:clamp(18px,3vw,28px);max-width:640px;margin-top:18px;box-shadow:10px 10px 0 var(--blood)}
.lr-card h3{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:clamp(30px,3.4vw,46px);text-transform:uppercase;line-height:.95}
.lr-card p{margin:10px 0 18px;color:#d8d4cc;font-size:17px}
.lr-later{background:var(--blood);color:var(--void)}
.lr-later p{font-size:18px;font-weight:700;max-width:640px;margin-top:10px}
.lr-sec .ctas{margin-top:20px}
.sitefoot{display:block;padding:50px max(16px,4vw) 110px;border-top:4px solid var(--blood);background:var(--void);color:var(--bone);text-transform:none;letter-spacing:0;font-size:15px}
.sitefoot .fcols{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:30px}
@media(max-width:800px){.sitefoot .fcols{grid-template-columns:1fr 1fr}}
.sitefoot b{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:34px}.sitefoot b i{font-style:normal;color:var(--blood)}
.sitefoot p{color:var(--ash);margin-top:8px}
.sitefoot nav{display:flex;flex-direction:column;gap:8px}
.sitefoot nav span{font-weight:700;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--ash)}
.sitefoot nav a:hover{color:var(--hot)}
.sitefoot .fcopy{margin-top:34px;font-size:12px;letter-spacing:.15em;text-transform:uppercase}
</style>
</head>
<body>
<!--@inject header.ghx-header-->

<main id="main-content">
<header class="lr-hero">
  <span class="kicker">✶ GhostHeart / Lives</span>
  <h1 class="display">Sunday <span>Lives.</span></h1>
  <p class="lead">Every Sunday at 10:00 a.m. Central I go live on TikTok and write songs on screen.</p>
</header>

<section class="lr-sec lr-lives" id="lives" aria-labelledby="live-status-title">
  <span class="lr-next">Sunday Lives · 10:00 a.m. Central · TikTok</span>
  <h2 id="live-status-title" data-live-next>Next Live: <span data-live-slot-label data-live-until="2026-11-15T16:45:00Z" data-live-after="coming soon">Sunday, November 1, 2026, 10:00 a.m. Central</span>.</h2>
  <p class="topic" data-live-slot-topic>This Live: &ldquo;Who I Am,&rdquo; written live.</p>
  <div class="ctas"><a class="btn dark" href="https://www.tiktok.com/@ghosthearted1">Watch at @ghosthearted1 ↗</a></div>
  <ul class="lr-list" aria-label="Upcoming Lives">
    <li data-live-slot data-live-hide-after="2026-11-01T16:45:00Z" data-live-when="Sunday, November 1, 2026, 10:00 a.m. Central" data-live-topic="This Live: &ldquo;Who I Am,&rdquo; written live."><b>Sun, Nov 1</b><span>&ldquo;Who I Am,&rdquo; written live.</span></li>
    <li data-live-slot data-live-hide-after="2026-11-08T16:45:00Z" data-live-when="Sunday, November 8, 2026, 10:00 a.m. Central" data-live-topic="This Live: share a few words about someone you love or miss, and I&rsquo;ll write a verse on screen."><b>Sun, Nov 8</b><span>Share a few words about someone you love or miss, and I&rsquo;ll write a verse on screen.</span></li>
    <li data-live-slot data-live-hide-after="2026-11-15T16:45:00Z" data-live-when="Sunday, November 15, 2026, 10:00 a.m. Central" data-live-topic="This Live: Still Here."><b>Sun, Nov 15</b><span>Still Here Live.</span></li>
  </ul>
  <p class="lr-small"><a href="/follow/">Join the email list</a> to hear about each Live before it starts.</p>
</section>

<section class="lr-sec lr-later" aria-label="More from GhostHeart">
  <div class="ctas"><a class="btn dark" href="/music/">Hear the music ↗</a><a class="btn" style="background:var(--bone);color:var(--void);border-color:var(--void)" href="/GhostHeart_Story.html">Enter My World</a></div>
</section>

</main>

<footer class="sitefoot">
  <div class="fcols">
    <div><b>GHOST<i>HEART</i></b><p>Real stories. Real people. Same heart.</p></div>
    <nav aria-label="Listen and watch"><span>Listen &amp; watch</span><a href="/music/">Music</a><a href="/GhostHeart_Videos.html">Films</a><a href="/live/">Lives</a></nav>
    <nav aria-label="Read"><span>Read</span><a href="/GhostHeart_Story.html">Enter My World</a><a href="/journal/">Blog</a></nav>
    <nav aria-label="Stay"><span>Stay</span><a href="/vault/">The Vault</a><a href="/follow/">Stay Connected</a><a href="/GhostHeart_Resources.html">Help &amp; Resources</a><a href="/GhostHeart_Privacy.html">Privacy</a></nav>
  </div>
  <p class="fcopy">© 2026 GhostHeart Studios</p>
</footer>

<script src="/assets/shared/ghostheart-world.js"></script>
<script src="/assets/loud/loud.js"></script>
<script defer src="/assets/shared/next-live.js"></script>
</body>
</html>
