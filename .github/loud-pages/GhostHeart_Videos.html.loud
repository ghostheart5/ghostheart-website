<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!--@inject-all head > meta[property], head > meta[name^="twitter:"], head > link[rel="canonical"]-->
<meta name="description" content="GhostHeart music videos, lyric videos and cinematic remakes.">
<title>Films | GhostHeart</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Permanent+Marker&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/loud/loud.css">
<style>
.fhero{position:relative;padding:150px clamp(16px,4vw,48px) 60px;overflow:hidden;isolation:isolate;background:#000}
.fhero::before{content:"";position:absolute;inset:0;z-index:-2;background:url('/assets/story/ghostheart-awakening-banner.png') center/cover;opacity:.3;filter:saturate(1.3)}
.fhero::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,var(--void) 15%,transparent 70%),linear-gradient(transparent 60%,var(--void))}
.fhero h1{font-size:clamp(80px,13vw,220px);margin-top:18px}
.fhero h1 .r{color:var(--blood);display:inline-block;text-shadow:3px 0 var(--glitch),-3px 0 var(--hot);animation:glitch 3.2s infinite steps(1)}
.fhero .tag{max-width:600px}
.feature{display:grid;grid-template-columns:1.4fr 1fr;gap:clamp(20px,3vw,40px);align-items:center;margin-top:20px}
@media(max-width:900px){.feature{grid-template-columns:1fr}}
.feature .thumb{position:relative;display:block;aspect-ratio:16/9;max-width:100%;background:#000 center/cover;border:6px solid var(--bone);box-shadow:16px 16px 0 var(--blood)}
.feature .thumb .p,.card .p{position:absolute;left:50%;top:50%;translate:-50% -50%;width:92px;height:92px;border-radius:50%;background:var(--blood);display:grid;place-items:center;animation:heart 1.1s infinite;box-shadow:0 0 40px rgba(232,0,28,.7)}
.feature .thumb .p svg,.card .p svg{width:34px;fill:var(--void)}
.feature small{display:block;font-weight:700;letter-spacing:.2em;font-size:12px;color:var(--hot);text-transform:uppercase}
.feature h2{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:clamp(60px,7vw,120px);line-height:.85;text-transform:uppercase;margin:10px 0 14px}
.feature p{font-size:clamp(18px,1.8vw,22px);margin-bottom:24px}

.controls{position:sticky;top:62px;z-index:60;background:var(--void);border-block:4px solid var(--blood);padding:14px clamp(16px,4vw,48px);display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.controls input{flex:1 1 260px;min-width:0;background:#111;border:2px solid #333;color:var(--bone);font:700 18px "Space Grotesk",sans-serif;padding:12px 14px;outline:none}
.controls input:focus{border-color:var(--blood)}
.controls .count{font-weight:700;letter-spacing:.18em;font-size:12px;text-transform:uppercase;color:var(--ash)}
.reel{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:22px}
.card{display:flex;flex-direction:column;background:#0b0b0b;border:3px solid #262626;transition:.14s}
.card:hover{transform:translate(-4px,-4px);box-shadow:8px 8px 0 var(--blood);border-color:var(--blood)}
.card .thumb{position:relative;display:block;aspect-ratio:16/9;background:#000 center/cover}
.card .p{width:62px;height:62px;animation:none}
.card .p svg{width:24px}
.card:hover .p{animation:heart 1.1s infinite}
.card .body{padding:18px 20px 22px;display:flex;flex-direction:column;gap:8px;flex:1}
.card small{font-weight:700;letter-spacing:.18em;font-size:11px;color:var(--ash);text-transform:uppercase}
.card h3{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:clamp(32px,3vw,44px);line-height:.9;text-transform:uppercase}
.card p{color:#c9c6c1;font-size:16px;line-height:1.45}
.card .go{margin-top:auto;padding-top:10px;display:flex;flex-wrap:wrap;gap:14px;font-weight:700;letter-spacing:.14em;font-size:12px;text-transform:uppercase}
.card .go a:first-child{color:var(--hot)}
.card .go a:hover{text-decoration:underline}
.card[hidden]{display:none}
.empty{display:none;padding:50px 0;font-family:Anton,Impact,sans-serif;font-size:clamp(40px,6vw,80px);color:var(--blood);text-transform:uppercase}
.sitefoot{display:block;padding:50px max(16px,4vw) 110px;border-top:4px solid var(--blood);background:var(--void);color:var(--bone);text-transform:none;letter-spacing:0;font-size:15px}
.sitefoot .fcols{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:30px}
@media(max-width:800px){.sitefoot .fcols{grid-template-columns:1fr 1fr}}
.sitefoot b{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:34px}.sitefoot b i{font-style:normal;color:var(--blood)}
.sitefoot p{color:var(--ash);margin-top:8px}
.sitefoot nav{display:flex;flex-direction:column;gap:8px}
.sitefoot nav span{font-weight:700;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--ash)}
.sitefoot nav a:hover{color:var(--hot)}
.sitefoot .fcopy{margin-top:34px;font-size:12px;letter-spacing:.15em;text-transform:uppercase}
/* injected library (approved film cards) restyled */
.films-lib [data-filter-controls]{position:sticky;top:62px;z-index:60;background:var(--void);border-block:4px solid var(--blood);padding:14px 0;margin-bottom:28px;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.films-lib [data-filter-controls] label{font-weight:700;letter-spacing:.18em;font-size:12px;text-transform:uppercase;color:var(--ash);width:100%}
.films-lib [data-filter-controls] div{display:flex;flex-wrap:wrap;gap:10px;flex:1 1 100%}
.films-lib input[type=search]{flex:1 1 240px;min-width:0;background:#111;border:2px solid #333;color:var(--bone);font:700 18px "Space Grotesk",sans-serif;padding:12px 14px}
.films-lib input[type=search]:focus{border-color:var(--blood);outline:none}
.films-lib [data-clear-search]{font-family:Anton,Impact,sans-serif;font-size:18px;text-transform:uppercase;padding:10px 16px;border:2px solid var(--bone)}
.films-lib #library-results{font-weight:700;letter-spacing:.16em;font-size:12px;text-transform:uppercase;color:var(--ash)}
.films-lib [data-library-empty]{font-family:Anton,Impact,sans-serif;font-size:clamp(34px,5vw,64px);color:var(--blood);text-transform:uppercase}
.g-films{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:22px}
.g-film{display:flex;flex-direction:column;background:#0b0b0b;border:3px solid #262626;transition:.14s;padding-bottom:20px}
.g-film:hover{transform:translate(-4px,-4px);box-shadow:8px 8px 0 var(--blood);border-color:var(--blood)}
.g-film[hidden]{display:none}
.g-player{position:relative;aspect-ratio:16/9;background:#000;overflow:hidden;max-width:100%}
.g-player button{position:absolute;inset:0;width:100%;height:100%;padding:0;display:block}
.g-player img{width:100%;height:100%;object-fit:cover;display:block}
.g-player iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.g-play{position:absolute;left:50%;top:50%;translate:-50% -50%;width:66px;height:66px;border-radius:50%;background:var(--blood);color:var(--void);display:grid;place-items:center;font-size:24px;box-shadow:0 0 30px rgba(232,0,28,.6)}
.g-film:hover .g-play{animation:heart 1.1s infinite}
.g-play-label{position:absolute;left:12px;bottom:10px;font-weight:700;font-size:11px;letter-spacing:.2em;text-transform:uppercase;background:rgba(5,5,5,.75);padding:4px 8px}
.g-close{align-self:flex-start;margin:10px 20px 0;font-weight:700;font-size:12px;letter-spacing:.14em;text-transform:uppercase;border:2px solid var(--bone);padding:6px 10px}
.g-close[hidden]{display:none}
.g-film h3{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:clamp(32px,3vw,44px);line-height:.9;text-transform:uppercase;margin:16px 20px 6px}
.g-film .g-small{margin:0 20px;font-weight:700;letter-spacing:.16em;font-size:11px;color:var(--ash);text-transform:uppercase}
.g-film p{margin:8px 20px 0;color:#c9c6c1;font-size:16px;line-height:1.45}
.g-film .g-actions{margin:auto 20px 0;padding-top:14px;display:flex;flex-wrap:wrap;gap:14px;font-weight:700;letter-spacing:.14em;font-size:12px;text-transform:uppercase}
.g-film .g-actions a:first-child{color:var(--hot)}
.g-film .g-actions a:hover{text-decoration:underline}
.g-films > span[hidden],.l-anchor-alias{display:none}
</style>
</head>
<body>
<!--@inject header.ghx-header-->

<!--@inject-all main > span.l-anchor-alias-->
<header class="fhero">
  <span class="kicker">✶ Music &amp; films / Watch</span>
  <h1 class="display">Stay With<br>the <span class="r">Story.</span></h1>
  <p class="tag">Music videos, lyric videos and cinematic remakes. Twelve films. Pick one.</p>
  <div class="feature">
    <a class="thumb" href="https://www.youtube.com/watch?v=RtFTIssLd0s" style="display:grid;place-items:center;background:var(--blood)" aria-label="Watch It's Not the 1950s full film"><span class="p"><svg viewBox="0 0 24 24"><path d="M7 4v16l13-8z"/></svg></span></a>
    <div>
      <small>FEATURED NOW</small>
      <h2>It's Not the 1950s</h2>
      <p>Grandma remembers the rights people fought for—and the pain behind the victory speeches. Listen to who paid the price.</p>
      <div class="ctas"><a class="btn red" href="https://www.youtube.com/watch?v=RtFTIssLd0s">Watch the full film</a></div>
    </div>
  </div>
</header>

<div class="tape"><div><span>LIGHTS DOWN</span><span>SOUND UP</span><span>✶ TWELVE FILMS ✶</span><span>PRESS PLAY</span><span>LIGHTS DOWN</span><span>SOUND UP</span><span>✶ TWELVE FILMS ✶</span><span>PRESS PLAY</span></div></div>

<section class="films-lib" id="all-films">
  <div class="label"><span>Every film / tap to load the player</span><span class="num">12</span></div>
  <!--@inject [data-library]-->
</section>

<section style="background:var(--blood);color:var(--void);text-align:center">
  <h2 class="display" style="font-size:clamp(70px,12vw,200px)">Never Miss<br><span style="color:var(--bone);text-shadow:6px 6px 0 var(--void)">The Next One.</span></h2>
  <div class="ctas" style="justify-content:center;margin-top:36px"><a class="btn dark" href="https://www.youtube.com/@GhostHeart-M95RTK">Follow on YouTube ↗</a><a class="btn" style="background:var(--bone);color:var(--void);border-color:var(--void)" href="/follow/">Stay Connected</a></div>
</section>

<footer class="sitefoot">
  <div class="fcols">
    <div><b>GHOST<i>HEART</i></b><p>Real stories. Real people. Same heart.</p></div>
    <nav aria-label="Listen and watch"><span>Listen &amp; watch</span><a href="/music/">Music</a><a href="/GhostHeart_Videos.html">Films</a><a href="/live/">Live</a></nav>
    <nav aria-label="Read"><span>Read</span><a href="/GhostHeart_Story.html">The Story</a><a href="/journal/">Blog</a><a href="/GhostHeart_Quotes.html">Quote Vault</a></nav>
    <nav aria-label="Stay"><span>Stay</span><a href="/vault/">The Vault</a><a href="/follow/">Stay Connected</a><a href="/GhostHeart_Resources.html">Help &amp; Resources</a><a href="/GhostHeart_Privacy.html">Privacy</a></nav>
  </div>
  <p class="fcopy">© 2026 GhostHeart Studios</p>
</footer>

<script src="/assets/shared/library-v3.js"></script>
<script src="/assets/shared/ghostheart-world.js"></script>
<script src="/assets/loud/loud.js"></script>
</body>
</html>
