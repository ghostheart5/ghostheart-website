  <div class="mega" aria-hidden="true"><div><span>You’re safe here</span><img class="mh" src="/assets/wake-v3/img/silver-heart.png" alt=""><b>Still here</b><img class="mh" src="/assets/wake-v3/img/silver-heart.png" alt=""><span>One heart</span><img class="mh" src="/assets/wake-v3/img/silver-heart.png" alt=""><b>Many voices</b><img class="mh" src="/assets/wake-v3/img/silver-heart.png" alt=""><span>You’re safe here</span><img class="mh" src="/assets/wake-v3/img/silver-heart.png" alt=""><b>Still here</b><img class="mh" src="/assets/wake-v3/img/silver-heart.png" alt=""><span>One heart</span><img class="mh" src="/assets/wake-v3/img/silver-heart.png" alt=""><b>Many voices</b><img class="mh" src="/assets/wake-v3/img/silver-heart.png" alt=""></div></div>

  <section class="wall2 feat2 lit" data-seed="23"><canvas class="paint" aria-hidden="true"></canvas>
    <span class="bgword r" aria-hidden="true">Stand watch</span>
    <div class="wrap">
      <div class="feat-head rv"><h2 class="bigtitle"><span class="steel">Featured</span> <span class="stn">week.</span></h2><span class="stamp s">Week 01 · Veterans Day</span></div>
      <div class="feat-grid">
        <div class="rv"><div class="poster deck">
          <span class="dogtag" aria-hidden="true"><b>To Those Who Served</b>Week 01 · Nov 11</span>
          <div class="head"><button class="playbig" type="button" data-play="to-those-who-served" aria-label="Play To Those Who Served">▶</button><div><h3>To Those Who Served</h3><p class="mono" style="margin-top:4px">The Heart Wakes <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></p></div></div>
          <p class="why">An original tribute to military veterans, with gratitude for their service and care that continues beyond Veterans Day.</p>
          <div class="row"><a class="btn" href="https://www.youtube.com/watch?v=U0X6SwISG_M" target="_blank" rel="noopener">Watch the full song ↗</a></div>
        </div></div>
        <div class="watch rv">
          <p class="sprayline"><span class="steel">You shouldn’t</span><br><span class="stn">stand alone.</span></p>
          <svg class="hb-line" viewBox="0 0 360 26" preserveAspectRatio="none" aria-hidden="true"><path d="M0 13 H150 L158 5 L166 13 L176 13 L184 1 L194 25 L202 13 H360"/></svg>
          <p class="watch-line">Check in. Listen. Keep showing up.</p>
          <p class="note">Veteran and struggling right now? <a href="tel:988">Call 988, then press 1</a>, or <a href="sms:838255">text 838255</a>.</p>
        </div>
      </div>
    </div>
  </section>

