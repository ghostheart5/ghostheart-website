<script>
(function(){
var LYRICS={"The Heart Wakes": "[Verse 1 — Male]\nI left my doubts on the kitchen chair,\nTurned up the song, let down my guard.\nThere’s a little more light in the morning air,\nAnd I’m done making joy so hard.\n\n[Verse 2 — Female]\nI’ve got two left feet and a brand-new plan,\nA laugh too loud for a room this small.\nTake a chance and take my hand—\nWe don’t have to know it all.\n\n[Chorus — Both]\nThe heart wakes—oh, here we go!\nA little more yes, a little less no.\nYou bring the spark, I’ll bring the beat,\nWe’ll find our way on these two left feet.\nHands up, let the daylight in—\nThe heart wakes, and we begin!\n\n[Verse 3 — Male]\nI used to save every little good thing\nFor a day when the hard part was through.\nNow I’m burning the toast while you laugh and sing,\nAnd I’m dancing round the kitchen with you.\n\n[Verse 4 — Female]\nWe can miss that turn, take the long way home,\nLet the radio lead us along.\nThere’s a whole wide world past the fear we’ve known,\nAnd I wanna hear you sing our song.\n\n[Bridge — Call and Response]\n[Male]\nI can’t promise easy.\n[Female]\nI don’t need you to.\n[Male]\nI can bring my whole heart.\n[Female]\nI can bring mine too.\n\n[Male]\nIf the next step feels unsteady,\n[Female]\nWe can take it side by side.\n[Male]\nI think I’m finally ready.\n[Female]\nThen let’s see what’s outside!\n\n[Final Chorus — Both]\nThe heart wakes—oh, here we go!\nA little more yes, a little less no.\nYou bring the spark, I’ll bring the beat,\nWe’ll find our way on these two left feet.\nHands up, let the daylight in—\nThe heart wakes, and we begin!\n\n[Short Outro — Both]\nYou bring the spark, I’ll bring the beat—\nThe heart wakes—\nCome dance with me!", "To Those Who Served": "[Verse 1 — Quiet, Raspy]\nYou gave your time, you stood your watch,\nYou carried out your part.\nBeyond the uniform you wore,\nThere lives a human heart.\n\nA life before, a life beyond,\nSome chapters yours to keep.\nWe don’t need every story told\nTo know our thanks run deep.\n\n[Chorus — Strong, Emotional]\nFor every kind of service,\nFor every road you’ve known—\nWith gratitude, we stand with you.\nYou shouldn’t stand alone.\n\nLet “thank you” turn to something\nThat lasts beyond today.\nYou deserve more than a passing word\nAs people walk away.\n\n[Verse 2 — A Little Tear in the Voice]\nSome came home to open arms,\nSome had to find their way.\nSome found pride in work well done,\nSome carry mixed feelings today.\n\nYou don’t owe us a perfect smile,\nOr words you’d rather save.\nYour worth was never measured\nBy how much more you gave.\n\n[Bridge — Building, Defiant]\nYou’ve got a right to speak your mind,\nA right to ask for more.\nA life that’s yours to choose and build—\nYou’ve got that right, for sure.\n\nSo let our thanks mean listening.\nLet respect show in what we do.\nWhen the speeches end and chairs fold up,\nLet care keep coming through.\n\n[Final Chorus — Full, Raspy, Resolute]\nFor every kind of service,\nFor every road you’ve known—\nWith gratitude, we stand with you.\nYou shouldn’t stand alone.\n\nLet “thank you” turn to something\nThat lasts beyond today.\nYou deserve more than a passing word\nAs people walk away.\n\n[Spoken — Rough Voice, Holding Back Tears]\nTo every veteran—\nthank you for your service.\nYour story matters.\nAnd so do you."};
var ALBUMS=[
 {id:"heart-wakes",title:"The Heart Wakes",cls:"c1",img:"/assets/wake-v3/img/heart-wakes.jpg",desc:"The new album. It opens one week at a time, and each song lands here the Sunday its week goes up.",tracks:[
  {f:"the-heart-wakes",t:"The Heart Wakes",why:"A playful duet about taking a chance on joy.",m:["love"]},
  {f:"to-those-who-served",t:"To Those Who Served",why:"For those who served, and for everything they still carry.",m:["protect"]}]}];
var MOODS=[["","Everything"],["love","I’m thinking about love"],["protect","I want to look out for someone"]];
var ALL=[];ALBUMS.forEach(function(a){a.tracks.forEach(function(t){t.album=a.title;t.i=ALL.length;ALL.push(t)})});
function $(s){return document.querySelector(s)}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
var reduce=window.matchMedia&&matchMedia("(prefers-reduced-motion: reduce)").matches;

/* ---- render vault ---- */
var box=$("#albums");
box.innerHTML=ALBUMS.map(function(a,n){
  return '<div class="album" data-album="'+a.id+'"><div class="poster '+(n%2?"":"l ")+'cover '+a.cls+'">'+(a.img?'<img src="'+a.img+'" alt="'+esc(a.title)+' album cover">':esc(a.title))+'</div><div><p class="mono"><b>Album</b> · <span class="cnt"></span></p><h2 class="chrome" style="margin:8px 0 10px">'+esc(a.title)+'</h2><p style="color:var(--silver);max-width:52ch">'+esc(a.desc)+'</p><ol class="tracks">'+
  a.tracks.map(function(t,k){return '<li data-i="'+t.i+'"><button class="trk" type="button" data-i="'+t.i+'"><span class="no">'+String(k+1).padStart(2,"0")+'</span><span><span class="ti">'+esc(t.t)+'</span><span class="why">'+esc(t.why)+'</span></span><span class="go">▶ Play</span></button></li>'}).join("")+
  '</ol></div></div>'}).join("")+'<p class="empty" id="vempty" hidden>No songs match that. Try another word or feeling.</p>';
var mood="";
$("#moods").innerHTML=MOODS.map(function(m){return '<button class="chip" type="button" data-m="'+m[0]+'" aria-pressed="'+(m[0]===""?"true":"false")+'">'+m[1]+'</button>'}).join("");
function filter(){var q=$("#vq").value.trim().toLowerCase().replace(/’/g,"'"),n=0;
  ALBUMS.forEach(function(a){var shown=0,el=box.querySelector('[data-album="'+a.id+'"]');
    a.tracks.forEach(function(t){var ok=(!mood||t.m.indexOf(mood)>=0)&&(!q||(t.t+" "+a.title+" "+t.why).toLowerCase().replace(/’/g,"'").indexOf(q)>=0);
      el.querySelector('li[data-i="'+t.i+'"]').hidden=!ok;if(ok)shown++});
    el.hidden=!shown;el.querySelector(".cnt").textContent=a.tracks.length+" songs";n+=shown});
  $("#vempty").hidden=n>0;$("#vcount").textContent=n+(n===1?" song":" songs")+" on The Heart Wakes so far"+((mood||q)?" match.":".")}
$("#vq").addEventListener("input",filter);
$("#moods").addEventListener("click",function(e){var b=e.target.closest(".chip");if(!b)return;mood=b.dataset.m;
  this.querySelectorAll(".chip").forEach(function(c){c.setAttribute("aria-pressed",c===b?"true":"false")});filter()});
filter();

document.querySelectorAll("[data-lyrics]").forEach(function(p){p.textContent=LYRICS[p.dataset.lyrics]||""});

/* ---- paint drips under every sprayed word ---- */
function rnd(seed){var s=seed;return function(){s=(s*9301+49297)%233280;return s/233280}}
[].forEach(function(el,k){var r=rnd(17+k*31+el.textContent.length),n=3+Math.floor(r()*3);
  for(var i=0;i<n;i++){var d=document.createElement("span");d.className="drip";d.setAttribute("aria-hidden","true");
    d.style.left=(6+r()*86)+"%";d.style.height=(.18+r()*.6)+"em";d.style.width=(3+r()*4)+"px";el.appendChild(d)}});

/* ---- the wall: spray with the mouse, click to switch cans ---- */
(function(){var hero=$("#wall"),cv=$("#spray");if(!cv)return;var c=cv.getContext("2d"),W=0,H=0,cans=["215,25,32","240,241,243","192,197,204"],can=0,drips=[],raf=0;
  function burst(x,y,rad,n,col,a){for(var i=0;i<n;i++){var ang=Math.random()*6.283,d=Math.pow(Math.random(),1.7)*rad;c.fillStyle="rgba("+col+","+(a*(.35+Math.random()*.65))+")";c.beginPath();c.arc(x+Math.cos(ang)*d,y+Math.sin(ang)*d,Math.random()*1.7+.3,0,6.283);c.fill()}}
  function seed(){var r=rnd(4242);function R(){return r()}
    var spots=[[.94,.16,130,cans[1]],[.07,.9,100,cans[0]],[.58,.06,70,cans[0]],[.8,.86,90,cans[2]]];
    spots.forEach(function(s){var x=s[0]*W,y=s[1]*H;for(var i=0;i<900;i++){var ang=R()*6.283,d=Math.pow(R(),1.6)*s[2];c.fillStyle="rgba("+s[3]+","+(.04+R()*.16)+")";c.beginPath();c.arc(x+Math.cos(ang)*d,y+Math.sin(ang)*d,R()*1.8+.3,0,6.283);c.fill()}})}
  function size(){var b=hero.getBoundingClientRect(),dpr=Math.min(2,devicePixelRatio||1);W=b.width;H=b.height;cv.width=W*dpr;cv.height=H*dpr;c.setTransform(dpr,0,0,dpr,0,0);seed()}
  function tick(){drips=drips.filter(function(d){c.fillStyle="rgba("+d.col+",.75)";c.fillRect(d.x,d.y,d.w,2.2);d.y+=1.6;d.len-=1.6;return d.len>0});raf=drips.length?requestAnimationFrame(tick):0}
  size();addEventListener("resize",size);
  if(reduce||!window.matchMedia||!matchMedia("(hover:hover)").matches)return;
  hero.addEventListener("pointermove",function(e){if(e.pointerType!=="mouse")return;var b=hero.getBoundingClientRect(),x=e.clientX-b.left,y=e.clientY-b.top;
    burst(x,y,20,26,cans[can],.5);if(false){drips.push({x:x-6+Math.random()*12,y:y+6,w:2+Math.random()*3,len:30+Math.random()*120,col:cans[can]});if(!raf)raf=requestAnimationFrame(tick)}});
  hero.addEventListener("click",function(e){if(e.target.closest("a,button"))return;can=(can+1)%cans.length});
})();

/* ---- player ---- */
var au=new Audio(),cur=-1,bar=$("#player"),pp=$("#p-pp"),seek=$("#p-seek"),dragging=false;au.preload="none";
function fmt(s){if(!isFinite(s))return "0:00";s=Math.floor(s);return Math.floor(s/60)+":"+String(s%60).padStart(2,"0")}
function paint(){var playing=!au.paused;document.body.classList.toggle("playing",playing);pp.textContent=playing?"❚❚":"▶";pp.setAttribute("aria-label",playing?"Pause":"Play");
  document.querySelectorAll(".trk").forEach(function(b){var on=+b.dataset.i===cur;b.classList.toggle("on",on);b.querySelector(".go").innerHTML=on&&playing?'<span class="eq"><i></i><i></i><i></i><i></i><i></i></span> Playing':"▶ Play"});
  document.querySelectorAll(".playbig[data-play]").forEach(function(b){var t=ALL[cur];b.textContent=t&&t.f===b.dataset.play&&playing?"❚❚":"▶"})}
function play(i){if(i<0||i>=ALL.length)return;if(i===cur){au.paused?au.play():au.pause();return}
  cur=i;var t=ALL[i];au.src=(/^(the-heart-wakes|to-those-who-served)$/.test(t.f)?"/assets/wake-v3/audio/":"/assets/music/preview/")+t.f+".mp3";au.play().catch(function(){$("#p-title").innerHTML=esc(t.t)+'<span>Could not load this song</span>'});
  $("#p-title").innerHTML=esc(t.t)+'<span>'+esc(t.album)+'</span>';bar.hidden=false;
  document.body.style.setProperty("--player-h",bar.offsetHeight+"px");paint()}
document.addEventListener("click",function(e){var b=e.target.closest(".trk");if(b){play(+b.dataset.i);return}
  var p=e.target.closest("[data-play]");if(p){for(var k=0;k<ALL.length;k++)if(ALL[k].f===p.dataset.play){play(k);break}}});
pp.addEventListener("click",function(){au.paused?au.play():au.pause()});
$("#p-prev").addEventListener("click",function(){play((cur-1+ALL.length)%ALL.length)});
$("#p-next").addEventListener("click",function(){play((cur+1)%ALL.length)});
au.addEventListener("play",paint);au.addEventListener("pause",paint);
au.addEventListener("ended",function(){if(cur<ALL.length-1)play(cur+1);else paint()});
au.addEventListener("timeupdate",function(){if(!dragging&&au.duration)seek.value=Math.round(au.currentTime/au.duration*1000);$("#p-time").textContent=fmt(au.currentTime)+" / "+fmt(au.duration)});
seek.addEventListener("input",function(){dragging=true});
seek.addEventListener("change",function(){if(au.duration)au.currentTime=seek.value/1000*au.duration;dragging=false});

/* ---- routes ---- */
var VIEWS=["home","vault","story","live","merch"];
function route(){var h=(location.hash||"").slice(1),spot=VIEWS.indexOf(h)<0&&h?document.getElementById(h):null;if(VIEWS.indexOf(h)<0)h="home";
  VIEWS.forEach(function(v){$("#v-"+v).hidden=v!==h});
  document.querySelectorAll("[data-nav]").forEach(function(a){if(a.dataset.nav===h){a.setAttribute("aria-current","page");a.scrollIntoView({block:"nearest",inline:"nearest"})}else a.removeAttribute("aria-current")});
  document.body.dataset.view=h;if(spot)spot.scrollIntoView();else window.scrollTo(0,0);if(h==="home"){window.dispatchEvent(new Event("resize"));if(window.__paintHome)window.__paintHome()}}

/* ---- HOME v2 paint: splats, drips, the bleeding banner, embers ---- */
(function(){
  function fit(cv){var b=cv.parentNode.getBoundingClientRect(),dpr=Math.min(2,devicePixelRatio||1),c=cv.getContext("2d");cv.width=Math.max(1,b.width*dpr);cv.height=Math.max(1,b.height*dpr);c.setTransform(dpr,0,0,dpr,0,0);return {c:c,W:b.width,H:b.height}}
  var RED="215,25,32",HOT="255,43,43",SIL="192,197,204",WHT="240,241,243";
  function splat(c,R,x,y,rad,col){
    c.fillStyle="rgba("+col+",.92)";c.beginPath();c.arc(x,y,rad,0,6.283);c.fill();
    var n=8+Math.floor(R()*10);for(var i=0;i<n;i++){var a=R()*6.283,d=rad*(1+R()*2.6),r=rad*(.06+R()*.22);
      c.beginPath();c.arc(x+Math.cos(a)*d,y+Math.sin(a)*d,r,0,6.283);c.fill();
      if(R()<.5){c.lineWidth=r*.9;c.strokeStyle="rgba("+col+",.8)";c.beginPath();c.moveTo(x+Math.cos(a)*rad*.8,y+Math.sin(a)*rad*.8);c.lineTo(x+Math.cos(a)*d,y+Math.sin(a)*d);c.stroke()}}
    var k=2+Math.floor(R()*3);for(var j=0;j<k;j++){var dx=x-rad*.7+R()*rad*1.4,w=2+R()*rad*.22,len=rad*(1.5+R()*5);
      c.fillRect(dx,y,w,len);c.beginPath();c.arc(dx+w/2,y+len,w*.75,0,6.283);c.fill()}}
  function cloud(c,R,x,y,rad,col,a){for(var i=0;i<1100;i++){var g=R()*6.283,d=Math.pow(R(),1.5)*rad;c.fillStyle="rgba("+col+","+(a*(.2+R()*.8))+")";c.beginPath();c.arc(x+Math.cos(g)*d,y+Math.sin(g)*d,R()*1.9+.3,0,6.283);c.fill()}}
  function slash(c,R,W,H,col){c.strokeStyle="rgba("+col+",.55)";c.lineCap="round";c.lineWidth=6+R()*10;c.beginPath();var x=R()*W*.3,y=H*(.2+R()*.6);c.moveTo(x,y);
    for(var i=0;i<4;i++){x+=W*(.08+R()*.12);y+=(R()-.5)*H*.5;c.quadraticCurveTo(x-30,y+40*(R()-.5),x,y)}c.stroke()}
  function paintWall(cv,seed){var f=fit(cv),c=f.c,W=f.W,H=f.H,R=rnd(seed);
    cloud(c,R,W*(.75+R()*.2),H*(.1+R()*.3),140+R()*80,SIL,.1);cloud(c,R,W*R()*.3,H*(.6+R()*.4),120,RED,.14);
    slash(c,R,W,H,RED);
    cloud(c,R,W*(.4+R()*.3),H*R(),90,WHT,.06)}
  function bleed(cv){var f=fit(cv),c=f.c,W=f.W,H=f.H,R=rnd(909),drips=[];
    for(var x=0;x<W;){var w=3+R()*16;drips.push({x:x,w:w,len:H*(.15+Math.pow(R(),2)*.85)});x+=w+R()*38}
    function draw(p){c.clearRect(0,0,W,H);var g=c.createLinearGradient(0,0,0,H);g.addColorStop(0,"rgba(215,25,32,1)");g.addColorStop(1,"rgba(150,12,18,.95)");c.fillStyle=g;
      c.fillRect(0,0,W,4);drips.forEach(function(d){var L=d.len*p;c.fillRect(d.x,0,d.w,L);c.beginPath();c.arc(d.x+d.w/2,L,d.w*.62,0,6.283);c.fill()})}
    if(reduce){draw(1);return}var t0=0;(function step(t){if(!t0)t0=t;var p=Math.min(1,(t-t0)/1800);draw(1-Math.pow(1-p,3));if(p<1)requestAnimationFrame(step)})(0)}
  function paintAll(){document.querySelectorAll(".home2 .wall2").forEach(function(s){paintWall(s.querySelector(".paint"),+s.dataset.seed||1)});}
  /* embers rise only while the fire is on screen */
  var fire=document.querySelector(".fire2"),ec=fire&&fire.querySelector(".embers"),E=[],on=false,eraf=0,ef=null;
  function emb(){ef=fit(ec);E=[];for(var i=0;i<70;i++)E.push(newE(true))}
  function newE(any){return {x:Math.random()*ef.W,y:any?Math.random()*ef.H:ef.H+10,v:.4+Math.random()*1.4,r:.8+Math.random()*2.4,s:Math.random()*6.28,col:Math.random()<.18?WHT:(Math.random()<.5?HOT:RED)}}
  function etick(){var c=ef.c;c.clearRect(0,0,ef.W,ef.H);E.forEach(function(p,i){p.y-=p.v;p.s+=.03;p.x+=Math.sin(p.s)*.6;var a=Math.max(0,Math.min(1,p.y/ef.H));c.fillStyle="rgba("+p.col+","+(a*.9)+")";c.beginPath();c.arc(p.x,p.y,p.r,0,6.283);c.fill();if(p.y<-10)E[i]=newE(false)});eraf=on?requestAnimationFrame(etick):0}
  if(ec){emb();if(!reduce&&"IntersectionObserver" in window)new IntersectionObserver(function(es){on=es[0].isIntersecting;if(on&&!eraf)eraf=requestAnimationFrame(etick)}).observe(fire);else etick()}
  var tm;addEventListener("resize",function(){clearTimeout(tm);tm=setTimeout(function(){paintAll();if(ec)emb()},150)});
  window.__paintHome=function(){paintAll();if(ec)emb()};
  var img=document.querySelector(".banner img");if(img&&!img.complete)img.addEventListener("load",paintAll);
  paintAll();
})();

/* ---- HOME v3 motion: scroll bar, reveal, banner tilt, mouse light ---- */
(function(){
  var home=$("#v-home"),root=document.documentElement,prog=home.querySelector(".prog");
  function onScroll(){var m=root.scrollHeight-innerHeight;prog.style.setProperty("--p",m>0?Math.min(1,scrollY/m):0)}
  addEventListener("scroll",onScroll,{passive:true});onScroll();
  if(reduce)return;
  if("IntersectionObserver" in window){root.classList.add("js-anim");
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target)}})},{threshold:.12});
    window.__io=io;home.querySelectorAll(".rv").forEach(function(el){io.observe(el)})}
  if(!window.matchMedia||!matchMedia("(hover:hover)").matches)return;
  var ban=$("#banner"),fr=ban.querySelector(".banner-frame");
  ban.addEventListener("pointermove",function(e){var b=fr.getBoundingClientRect(),dx=(e.clientX-b.left)/b.width-.5,dy=(e.clientY-b.top)/b.height-.5;
    fr.style.transform="rotateY("+(dx*8).toFixed(2)+"deg) rotateX("+(-dy*7).toFixed(2)+"deg) scale(1.015)"});
  ban.addEventListener("pointerleave",function(){fr.style.transform=""});
  document.addEventListener("pointermove",function(e){var t=e.target.closest&&e.target.closest(".lit");if(!t)return;var b=t.getBoundingClientRect();t.style.setProperty("--mx",(e.clientX-b.left)+"px");t.style.setProperty("--my",(e.clientY-b.top)+"px")});
})();

/* ---- v4: silver heart strips on every page, today's line, the Silver Thread ---- */
(function(){
  var HEART="/assets/wake-v3/img/silver-heart.png",HP="M50 88 C20 62 4 44 4 27 C4 13 15 4 28 4 C38 4 46 10 50 18 C54 10 62 4 72 4 C85 4 96 13 96 27 C96 44 80 62 50 88Z",SHCSS="\n@keyframes roll{to{transform:translateX(-50%)}}\n@keyframes corebeat{0%,60%,100%{transform:scale(1)}12%{transform:scale(1.15)}24%{transform:scale(.97)}36%{transform:scale(1.08)}}\n@keyframes ring{0%{transform:scale(1);opacity:.95}100%{transform:scale(2.7);opacity:0}}\n@keyframes ekg{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}\n@keyframes ekg2{from{stroke-dashoffset:.89}to{stroke-dashoffset:-.11}}\n@keyframes gl1{0%,90%,100%{opacity:0}91%{opacity:.95;transform:translate(-5px,2px);clip-path:inset(8% 0 58% 0)}93%{opacity:.95;transform:translate(6px,-2px);clip-path:inset(62% 0 6% 0)}95%{opacity:.95;transform:translate(-3px,0);clip-path:inset(32% 0 34% 0)}97%{opacity:0}}\n@keyframes gl2{0%,91%,100%{opacity:0}92%{opacity:.9;transform:translate(5px,-1px);clip-path:inset(48% 0 22% 0)}94%{opacity:.9;transform:translate(-6px,2px);clip-path:inset(4% 0 72% 0)}96%{opacity:0}}\n.ekg{height:clamp(34px,4.4vw,56px);background:#000;position:relative;line-height:0}\n.ekg svg{width:100%;height:100%;display:block;overflow:visible}\n.ekg path{fill:none;vector-effect:non-scaling-stroke;stroke-linejoin:round}\n.ekg .base{stroke:rgba(215,25,32,.3);stroke-width:1.5}\n.ekg .run{stroke:#ff3b3f;stroke-width:3;stroke-dasharray:.14 .86;animation:ekg 3.2s linear infinite;filter:drop-shadow(0 0 6px #ff2b2b) drop-shadow(0 0 16px #D71920)}\n.ekg .run.r2{stroke:#fff;stroke-width:1.5;stroke-dasharray:.03 .97;animation-name:ekg2}\n.ticker{overflow:hidden;background:#D71920;color:#000;border-block:2px solid #000;transform:rotate(-.9deg) scale(1.04);position:relative;z-index:3}\n.ticker div{display:flex;width:max-content;font:400 clamp(1.1rem,1.9vw,1.5rem)/1 \"Saira Stencil One\",\"Bebas Neue\",Impact,sans-serif;letter-spacing:.08em;padding:7px 0 6px;white-space:nowrap;animation:roll 40s linear infinite}\n.ticker div>span{margin-right:26px}\n.heartfx{position:relative;aspect-ratio:100/92}\n.heartfx svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}\n.glitch{position:relative;display:inline-block}\n.glitch::before,.glitch::after{content:attr(data-text);position:absolute;left:0;top:0;opacity:0;pointer-events:none;-webkit-text-fill-color:currentColor}\n.glitch::before{color:#D71920;animation:gl1 5s infinite steps(1)}\n.glitch::after{color:#fff;animation:gl2 5s infinite steps(1)}\n.view{overflow-x:clip}\nsection{overflow:hidden}\n@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n\n.heartfx .ring{fill:none;stroke:#D71920;stroke-width:2.5;opacity:0;animation:ring 2.4s infinite cubic-bezier(.15,.6,.3,1)}\n.heartfx .r2{animation-delay:.8s;stroke:#C0C5CC}.heartfx .r3{animation-delay:1.6s}\n.heartfx img.core{position:absolute;left:50%;top:50%;width:116%;height:auto;max-width:none;translate:-50% -50%;display:block;animation:corebeat 1.2s infinite;filter:drop-shadow(0 0 14px rgba(255,43,43,.9)) drop-shadow(0 0 46px rgba(215,25,32,.65))}\nimg.tkh{display:inline-block;height:1.3em;width:auto;max-width:none;vertical-align:-.28em;margin-right:26px;animation:corebeat 1.2s infinite;filter:drop-shadow(0 0 5px rgba(0,0,0,.9))}\n.pagefx{position:relative;z-index:4;overflow:hidden;padding-bottom:10px}\n.pagefx .ticker{margin:0}\n.pageheart{position:absolute!important;right:max(18px,4vw);top:clamp(18px,3vw,40px);width:clamp(64px,9vw,128px)!important;z-index:1;pointer-events:none}\n.js-anim .rvo{opacity:0;translate:0 44px;transition:opacity .65s cubic-bezier(.2,.9,.1,1),translate .65s cubic-bezier(.2,.9,.1,1)}\n.js-anim .rvo.in{opacity:1;translate:0 0}\n",io=window.__io;
  var D=document.querySelector(".ekg .base").getAttribute("d");
  function heartHTML(cls){return '<div class="heartfx '+cls+'" aria-hidden="true">'+[1,2,3].map(function(n){return '<svg class="ring r'+n+'" viewBox="0 0 100 92"><path d="'+HP+'"/></svg>'}).join("")+'<img class="core" src="'+HEART+'" alt=""></div>'}
  function strip(words){var one=words.map(function(w){return '<span>'+w+'</span><img class="tkh" src="'+HEART+'" alt="">'}).join("");
    return '<div class="pagefx" aria-hidden="true"><div class="ekg"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path class="base" d="'+D+'"/><path class="run" pathLength="1" d="'+D+'"/><path class="run r2" pathLength="1" d="'+D+'"/></svg></div><div class="ticker red2"><div>'+one+one+'</div></div></div>'}
  var WORDS={vault:["THE VAULT","EVERY ALBUM","EVERY SONG","PRESS PLAY","TURN IT UP"],story:["BEHIND THE SCARS","NOT ONE WOUND","NOT ONE LABEL","STILL HERE"],live:["COME TO THE FIRE","SUNDAYS","LIVE ON TIKTOK","SIT DOWN","STAY A WHILE"],
    work:["HOW CAN I HELP","WORDS","DOCUMENTS","SLIDES","A SONG FROM YOUR STORY"],projects:["BUILD SOMETHING THAT HELPS","AXIOMARA","SHADOW FIRE","DEAL VECTOR","MAKE IT HUMAN"],resources:["YOU’RE NOT ALONE","CALL OR TEXT 988","YOU MATTER","STILL HERE"]};
  function glitch(root){var h=root.querySelector(".bigtitle .chrome");if(h){h.classList.add("glitch");h.dataset.text=h.textContent}}
  var watch=[];
  ["vault","story","live"].forEach(function(id){var v=$("#v-"+id);v.classList.add("fx");v.insertAdjacentHTML("afterbegin",strip(WORDS[id]));
    var sec=v.querySelector("section");sec.classList.add("lit");sec.insertAdjacentHTML("afterbegin",heartHTML("pageheart"));glitch(v);
    v.querySelectorAll(".stack>*:not(#albums):not(.prose):not(.steps):not(.heartfx),.album,.prose>*,.steps>li").forEach(function(el){el.classList.add("rvo");watch.push(el)})});
  if(io)watch.forEach(function(el){io.observe(el)});

  /* today's line: same 17 lines and the same midnight-Central schedule as the current site */
  (function(){var q=["Equality isn’t given; it’s reborn in the hearts of those who refuse to let it die.", "You can’t fight what you don’t face.", "When the promise breaks, the heart must carry it.", "They call it rebellion when you love who you want.", "You can’t close a revolving door, but you can get out.", "You can burn every bridge behind you, but ashes don’t rebuild paths.", "When the fire dies, silence becomes the loudest scream.", "I gave my life so yours could live—the heart that glows is the one that gave.", "Some bonds burn brighter... until they consume you.", "Everyone has something to say, but gets real quiet when it’s their turn.", "It doesn’t matter what they say; they couldn’t handle it anyway.", "I can’t draw or sing, but these are my words, and I say what I mean.", "Strength is quiet until it roars.", "Even broken steel remembers first.", "Love doesn’t ask permission to exist.", "Truth dances in silence.", "Reflection is rebellion."],MON=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"],p={};
    try{new Intl.DateTimeFormat("en-US",{timeZone:"America/Chicago",year:"numeric",month:"2-digit",day:"2-digit"}).formatToParts(new Date()).forEach(function(x){if(x.type!=="literal")p[x.type]=+x.value})}catch(e){var n=new Date();p={year:n.getFullYear(),month:n.getMonth()+1,day:n.getDate()}}
    var day=Math.floor(Date.UTC(p.year,p.month-1,p.day)/86400000),i=((day%q.length)+q.length)%q.length,w=q[i].split(" ");
    $("#q-text").innerHTML=w.map(function(x,k){return '<span class="w'+(k>=w.length-2?" hotw":"")+'" style="transition-delay:'+(120+k*70)+'ms">'+esc(x)+'</span>'}).join(" ");
    $("#qn").textContent=String(i+1).padStart(2,"0");$("#q-date").textContent=MON[p.month-1]+" "+p.day;})();

  /* the Silver Thread: the silver heart, with a thread running in from every person who joined */
  (function(){var cv=$("#living");if(!cv)return;var ANCH=[[.526,.251],[.45,.478],[.46,.682]],HI=new Image();HI.src=HEART;
    var c=cv.getContext("2d"),W=0,H=0,people=[],base=48,mine=0;
    function seed(k){var x=Math.sin(k*127.1)*43758.5453;return x-Math.floor(x)}
    function person(k,isMine,born){var side=seed(k+.3),u=seed(k+.7),x,y;
      if(side<.4){x=u*W;y=H-2-seed(k+1.1)*H*.12}else if(side<.7){x=2+seed(k+1.3)*W*.1;y=u*H}else{x=W-2-seed(k+1.7)*W*.1;y=u*H}
      return {x:x,y:y,mine:isMine,born:born,ph:seed(k+2.1)}}
    function sz(){var r=Math.min(2,devicePixelRatio||1);W=cv.clientWidth;H=cv.clientHeight;if(!W)return;cv.width=W*r;cv.height=H*r;c.setTransform(r,0,0,r,0,0);
      people=[];for(var k=0;k<base+mine;k++)people.push(person(k,k>=base,-9))}
    sz();addEventListener("resize",sz);
    window.__addThread=function(){if(!W)sz();mine++;people.push(person(base+mine-1,true,performance.now()/1000))};
    function f(now){if(cv.offsetParent){if(!W)sz();if(W){var t=now/1000;c.clearRect(0,0,W,H);
      var beat=reduce?.3:Math.pow(Math.max(0,Math.sin(t*5.236)),14)+.55*Math.pow(Math.max(0,Math.sin(t*5.236-.85)),14);
      var cx=W/2,cy=H*.47,s=Math.min(W,H)/40*(1+beat*.04),hs=s*36;
      var gl=c.createRadialGradient(cx,cy,0,cx,cy,s*26);gl.addColorStop(0,"rgba(215,25,32,"+(.35+beat*.4)+")");gl.addColorStop(1,"rgba(215,25,32,0)");c.fillStyle=gl;c.fillRect(0,0,W,H);
      if(HI.complete&&HI.naturalWidth)c.drawImage(HI,cx-hs/2,cy-hs*.47,hs,hs);
      people.forEach(function(p,i){var g=p.born<0?1:Math.min(1,Math.max(0,(t-p.born)/1.4));
        var an=ANCH[i%3],tx=cx-hs/2+an[0]*hs,ty=cy-hs*.47+an[1]*hs,mx=(p.x+tx)/2,my=Math.min(p.y,ty)-H*.08;
        c.strokeStyle=p.mine?"rgba(255,70,60,.95)":"rgba(220,224,230,"+(.26+.2*beat)+")";c.lineWidth=p.mine?1.6:.6;
        c.beginPath();c.moveTo(p.x,p.y);var steps=24;for(var k=1;k<=steps*g;k++){var q=k/steps,r=1-q;c.lineTo(r*r*p.x+2*r*q*mx+q*q*tx,r*r*p.y+2*r*q*my+q*q*ty)}c.stroke();
        if(i%3===0||p.mine){var e=(t*.35+p.ph)%1,r2=1-e;c.fillStyle="rgba(255,43,43,.95)";c.beginPath();c.arc(r2*r2*p.x+2*r2*e*mx+e*e*tx,r2*r2*p.y+2*r2*e*my+e*e*ty,p.mine?2:1.2,0,7);c.fill()}
        c.fillStyle=p.mine?"#F4483C":"rgba(240,241,243,.85)";c.beginPath();c.arc(p.x,p.y,p.mine?2.4:1.1,0,7);c.fill()})}}
      if(!reduce)requestAnimationFrame(f)}
    HI.onload=function(){requestAnimationFrame(f)};requestAnimationFrame(f);
    $("#join").addEventListener("submit",function(){window.__addThread()})})();
})();

addEventListener("hashchange",route);route();

/* ---- forms: the seat opens Mailchimp in a new tab to finish joining; the fire sends nothing ---- */
$("#join").addEventListener("submit",function(){$("#join-msg").textContent="Opening Mailchimp to finish joining. Thank you for taking a seat."});
function burn(){var i=$("#fire-in"),s=$("#said"),v=i.value.trim();if(!v)return;
  s.classList.remove("burn");s.textContent=v;void s.offsetWidth;s.classList.add("burn");i.value=""}
$("#fire-go").addEventListener("click",burn);$("#fire-in").addEventListener("keydown",function(e){if(e.key==="Enter"){e.preventDefault();burn()}});
})();
</script>
