  <section class="nv-vids" id="nv-vids" aria-labelledby="nv-vids-title">
    <h2 id="nv-vids-title">Out as videos</h2>
    <p class="nv-say">These play on YouTube.</p>
    <ol class="nv-list" id="nv-vidlist">
      <li><a class="nv-vid" href="https://www.youtube.com/watch?v=U0X6SwISG_M" target="_blank" rel="noopener"><span class="no">1</span><span><span class="ti">To Those Who Served</span><span class="why">For those who served, and for everything they still carry.</span></span><span class="go">Watch ↗</span></a></li>
      <li><a class="nv-vid" href="https://www.youtube.com/watch?v=XfF_B-_ZNxM" target="_blank" rel="noopener"><span class="no">2</span><span><span class="ti">The Parts You Hide</span><span class="why">A Country and Americana song, released for Trans Awareness Week.</span></span><span class="go">Watch ↗</span></a></li>
      <li><a class="nv-vid" href="https://www.youtube.com/watch?v=l_ftyUginiA" target="_blank" rel="noopener"><span class="no">3</span><span><span class="ti">The Man Beneath the Moon</span><span class="why">Back as a new music video.</span></span><span class="go">Watch ↗</span></a></li>
      <li data-from="2026-11-25T22:00:00Z" hidden><a class="nv-vid" href="https://www.youtube.com/watch?v=UTvuIgq-AWI" target="_blank" rel="noopener"><span class="no">4</span><span><span class="ti">Too Small</span><span class="why">Told through the eyes of a little boy in a house that does not feel safe.</span></span><span class="go">Watch ↗</span></a></li>
    </ol>
  </section>
  <script>
  /* Out as videos (Vault). A video with a date shows only once that time has passed; the search box and the feeling buttons filter this list too. */
  (function(){
    var box=document.getElementById("nv-vids"),items=[].slice.call(document.querySelectorAll("#nv-vidlist li")),q=document.getElementById("vq"),moods=document.getElementById("moods");
    function out(li){var f=li.getAttribute("data-from");return !f||Date.now()>=Date.parse(f)}
    function show(){
      var word=(q?q.value:"").trim().toLowerCase().replace(/’/g,"'"),pressed=moods&&moods.querySelector('.chip[aria-pressed="true"]'),mood=pressed?pressed.getAttribute("data-m"):"",n=0;
      items.forEach(function(li){var ok=out(li)&&!mood&&(!word||li.textContent.toLowerCase().replace(/’/g,"'").indexOf(word)>=0);li.hidden=!ok;if(ok)n++});
      box.hidden=!n;
      var none=document.getElementById("vempty");if(none&&n)none.hidden=true;
    }
    if(q)q.addEventListener("input",function(){setTimeout(show,0)});
    if(moods)moods.addEventListener("click",function(){setTimeout(show,0)});
    show();
  })();
  </script>
