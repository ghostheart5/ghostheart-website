  function pickCard(p){return '<span class="mono k">'+p.kind+'</span><b>'+p.title+'</b><p>'+p.why+'</p><a class="btn red" href="'+p.href+'"'+(p.ext?' target="_blank" rel="noopener"':'')+'>'+({line:"Carry this line",watch:"Watch",listen:"Listen",read:"Read"}[p.how]||"Open")+(p.ext?" ↗":"")+'</a>'}
  function matches(m,h){return FY.picks.filter(function(p){return p.moods.indexOf(m)>=0&&(!h||p.how===h)})}
  (function(){var f=document.querySelector(".fy-form");if(!f)return;var out=document.querySelector(".fy-out"),n=0;
    f.addEventListener("submit",function(e){e.preventDefault();var L=matches(f.querySelector(".fy-mood").value,f.querySelector(".fy-how").value);
      out.hidden=false;out.innerHTML=L.length?pickCard(L[n++%L.length]):"<p>Nothing for that mix yet. Try another time choice.</p>"})})();
  (function(){var ring=document.querySelector(".dial-ring");if(!ring)return;var mood=null,how="",n=0,out=document.querySelector(".dial-out"),hw=document.querySelector(".dial-how");
    function show(){var L=matches(mood,how);out.hidden=false;var h=ring.querySelector(".dial-heart");h.classList.remove("beat");void h.offsetWidth;h.classList.add("beat");
      out.innerHTML=L.length?pickCard(L[n%L.length])+(L.length>1?'<button type="button" class="btn ghost dial-next">Another one</button>':''):"<p>Nothing for that mix yet. Try another time.</p>";
      var nx=out.querySelector(".dial-next");if(nx)nx.addEventListener("click",function(){n++;show()})}
    ring.querySelectorAll(".dial-m").forEach(function(b){b.addEventListener("click",function(){mood=b.dataset.m;n=0;ring.querySelectorAll(".dial-m").forEach(function(x){x.classList.toggle("on",x===b)});hw.hidden=false;show()})});
    hw.querySelectorAll(".chip").forEach(function(c){c.addEventListener("click",function(){how=c.dataset.h;n=0;hw.querySelectorAll(".chip").forEach(function(x){x.classList.toggle("on",x===c)});if(mood)show()})});})();
  (function(){var inp=document.getElementById("v-search");if(!inp)return;var f="featured",items=document.querySelectorAll(".v-item"),cnt=document.querySelector(".v-count");
    function apply(){var q=inp.value.trim().toLowerCase(),n=0;items.forEach(function(i){var ok=(q?true:(f==="all"||(f==="featured"?i.dataset.feat==="1":i.dataset.kind===f)))&&(!q||i.dataset.search.indexOf(q)>=0);i.hidden=!ok;if(ok)n++});cnt.textContent=n+(q?" matches":" shown")+"."}
    inp.addEventListener("input",apply);document.querySelector(".v-clear").addEventListener("click",function(){inp.value="";apply()});
    document.querySelectorAll(".v-chips .chip").forEach(function(c){c.addEventListener("click",function(){f=c.dataset.v;document.querySelectorAll(".v-chips .chip").forEach(function(x){x.classList.toggle("on",x===c)});apply()})});apply()})();
