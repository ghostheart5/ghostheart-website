      <div class="alt alt-b" hidden>
        <p class="mono" style="margin:0 0 6px">New idea · The Heart Dial</p>
        <h1 class="giant dial-h"><span class="chrome">How’s your</span> <span class="red">heart?</span></h1>
        <p style="color:var(--silver);max-width:58ch;margin:4px 0 0">Tap what you’re feeling. The heart answers with one song, film, line or reading from the Vault, and why it fits.</p>
        <div class="dial">
          <div class="dial-ring"><button type="button" class="dial-m" data-m="strength" style="--i:0">I need strength</button><button type="button" class="dial-m" data-m="alone" style="--i:1">I want to feel less alone</button><button type="button" class="dial-m" data-m="judged" style="--i:2">I feel judged</button><button type="button" class="dial-m" data-m="change" style="--i:3">Something has to change</button><button type="button" class="dial-m" data-m="love" style="--i:4">I’m thinking about love</button><button type="button" class="dial-m" data-m="protect" style="--i:5">I want to look out for someone</button><img class="dial-heart" src="img/silver-heart.png" alt="" width="560" height="560"></div>
        </div>
        <div class="dial-how chips" hidden><span class="mono">How much time?</span><button type="button" class="chip on" data-h="">Any</button><button type="button" class="chip" data-h="line">Just a line <small>seconds</small></button><button type="button" class="chip" data-h="watch">Watch <small>1–5 minutes</small></button><button type="button" class="chip" data-h="listen">Listen <small>about 3 minutes</small></button><button type="button" class="chip" data-h="read">Read <small>5 minutes or more</small></button></div>
        <div class="dial-out panel" hidden aria-live="polite"></div>
      </div>
    </div>
  </section>
</div>

