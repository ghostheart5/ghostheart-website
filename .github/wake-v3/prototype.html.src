<main>
<!-- ============================== HOME ============================== -->
<div class="view" data-view="home">

  <!-- THE HEART WAKES: top of home -->
  <section class="hero" aria-label="The Heart Wakes">
    <div class="art" role="img" aria-label="The Heart Engine: a real heart wired into chrome cables in a dark industrial hall lit by red neon"></div>
    <div class="screen">
      <div class="wrap hw">
        <div class="hw-copy">
          <p class="mono" style="margin:0 0 14px"><b class="red">Wake the Heart</b> · the campaign · 14 weeks, Nov 9 to Feb 8</p>
          <h1 class="giant"><span class="chrome">The Heart</span><br><span class="heart">Wakes.</span></h1>
          <p class="mono" style="margin:10px 0 0;color:var(--song-heartwakes)">The Heart Wakes · the new album</p>
          <p class="core">It’s time to wake up the heart. <b>A heart does not change the world by beating alone. It changes the world by reaching another.</b></p>
          <p class="mono" style="color:var(--song-heartwakes);margin:0 0 20px">Week one goes up Sunday night</p>
          <div class="row">
            <a class="btn red" href="https://open.spotify.com/artist/68OskMXP10WmzJPexLzRc7" target="_blank" rel="noopener">Listen on Spotify ↗</a>
            <a class="btn" href="#wake">14 weeks</a>
          </div>
        </div>
        <div class="hw-cover panel"><img src="img/heart-wakes.jpg" alt="The Heart Wakes album cover: tattooed hands tearing open a shirt to show a cracked, glowing red heart" width="1000" height="1000"></div>
      </div>
    </div>
  </section>

  <!-- FEATURED WEEK -->
  <section>
    <span class="beam" style="left:72%" aria-hidden="true"></span>
    <div class="wrap">
      <div class="wk-head">
        <h2 class="giant" style="font-size:clamp(52px,8vw,120px)"><span class="chrome">Featured</span> <span class="red">week.</span></h2>
        <span class="stamp" style="font-size:clamp(22px,2.6vw,34px)">14 weeks</span>
      </div>
      <div class="featured" id="featured-home"></div>
    </div>
  </section>

  <!-- DAILY QUOTE: changes every day at midnight Central (same 17-quote schedule as the current site) -->
  <section class="qotd">
