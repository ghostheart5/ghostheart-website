    function apply(f){document.querySelectorAll(".res-grid .resource").forEach(function(a){var t=(a.getAttribute("data-tags")||"").split(" ");a.hidden=!(f==="all"||t.indexOf(f)>=0)});
      cs.forEach(function(c){var on=c.dataset.filter===f;c.classList.toggle("on",on);c.setAttribute("aria-pressed",on?"true":"false")})}
    cs.forEach(function(c){c.addEventListener("click",function(){apply(c.dataset.filter)})});apply("start")})();
  /* ---------- Silver Thread: a chrome heart, with a silver thread running in from every person who joined ---------- */
  (function(){
    var cv=document.getElementById("living");if(!cv)return;var ANCH=[[.526,.251],[.45,.478],[.46,.682]];/* the three silver beads on the heart */var HI=new Image();HI.src="img/silver-heart.png";HI.onload=function(){requestAnimationFrame(f)};var c=cv.getContext("2d"),W,H,people=[],base=48;
    var mine=+(store("gh-threads")||0);
    function seed(k){var x=Math.sin(k*127.1)*43758.5453;return x-Math.floor(x)}
    function heartPath(cx,cy,s){c.beginPath();for(var j=0;j<=100;j++){var t=j/100*Math.PI*2,x=16*Math.pow(Math.sin(t),3),y=-(13*Math.cos(t)-5*Math.cos(2*t)-2*Math.cos(3*t)-Math.cos(4*t));j?c.lineTo(cx+x*s,cy+y*s):c.moveTo(cx+x*s,cy+y*s)}c.closePath()}
    function person(k,isMine){var side=seed(k+.3),u=seed(k+.7),x,y;
      if(side<.4){x=u*W;y=H-2-seed(k+1.1)*H*.12}else if(side<.7){x=2+seed(k+1.3)*W*.1;y=u*H}else{x=W-2-seed(k+1.7)*W*.1;y=u*H}
      return {x:x,y:y,mine:isMine,born:isMine&&k>=base+mine-1&&people.length?performance.now()/1000:-9,ph:seed(k+2.1)}}
    function sz(){var r=Math.min(2,devicePixelRatio||1);W=cv.clientWidth;H=cv.clientHeight;if(!W)return;cv.width=W*r;cv.height=H*r;c.setTransform(r,0,0,r,0,0);
      people=[];for(var k=0;k<base+mine;k++)people.push(person(k,k>=base));people.forEach(function(p){p.born=-9})}
    sz();addEventListener("resize",sz);
    function setCount(){}/* no number shown until it reads real Mailchimp signups */
    document.querySelectorAll(".js-thread").forEach(function(form){form.addEventListener("submit",function(e){e.preventDefault();mine++;store("gh-threads",mine);var p=person(base+mine-1,true);p.born=performance.now()/1000;people.push(p);setCount();form.querySelector(".ok").hidden=false})});
    function f(now){if(cv.offsetParent&&W){var t=now/1000;c.clearRect(0,0,W,H);
      var beat=reduce?.3:Math.pow(Math.max(0,Math.sin(t*4.4)),14)+.55*Math.pow(Math.max(0,Math.sin(t*4.4-.85)),14);
      var cx=W/2,cy=H*.44,s=Math.min(W,H)/40*(1+beat*.035);
      // glow
      var gl=c.createRadialGradient(cx,cy,0,cx,cy,s*26);gl.addColorStop(0,"rgba(215,25,32,"+(.35+beat*.35)+")");gl.addColorStop(1,"rgba(215,25,32,0)");c.fillStyle=gl;c.fillRect(0,0,W,H);
      // heart: Dom's chrome-and-crimson heart (img/silver-heart.png), beating
      if(HI.complete&&HI.naturalWidth){var hs=s*36;c.drawImage(HI,cx-hs/2,cy-hs*.47,hs,hs)}
      // threads: from each person into the heart
      people.forEach(function(p,i){var age=t-p.born,g=Math.min(1,Math.max(0,age/1.4));if(p.born<0)g=1;
        var hs0=s*36,an=ANCH[i%3],tx=cx-hs0/2+an[0]*hs0,ty=cy-hs0*.47+an[1]*hs0,mx=(p.x+tx)/2,my=Math.min(p.y,ty)-H*.08;
        c.strokeStyle=p.mine?"rgba(244,72,60,.9)":"rgba(220,224,230,"+(.22+.16*beat)+")";c.lineWidth=p.mine?.8:.4;
        c.beginPath();c.moveTo(p.x,p.y);var steps=24;for(var k=1;k<=steps*g;k++){var q=k/steps,r=1-q;c.lineTo(r*r*p.x+2*r*q*mx+q*q*tx,r*r*p.y+2*r*q*my+q*q*ty)}c.stroke();
        if(i%3===0||p.mine){var e=(t*.35+p.ph)%1,r2=1-e;c.fillStyle="rgba(215,25,32,.95)";c.beginPath();c.arc(r2*r2*p.x+2*r2*e*mx+e*e*tx,r2*r2*p.y+2*r2*e*my+e*e*ty,1,0,7);c.fill()}
        c.fillStyle=p.mine?"#F4483C":"rgba(240,241,243,.8)";c.beginPath();c.arc(p.x,p.y,p.mine?1.6:.9,0,7);c.fill()});
      }
      if(!reduce)requestAnimationFrame(f)}
    requestAnimationFrame(f);
  })();

  /* ---------- chrome broadcast tower (Lives) ---------- */
  function tower(id){var s=document.getElementById(id);if(!s)return;var h="";
    h+='<defs><linearGradient id="ch'+id+'" x1="0" x2="1"><stop offset="0" stop-color="#5b6068"/><stop offset=".45" stop-color="#F0F1F3"/><stop offset=".55" stop-color="#8f959d"/><stop offset="1" stop-color="#33363D"/></linearGradient></defs>';
    h+='<g stroke="url(#ch'+id+')" stroke-width="2" fill="none"><path d="M60 340 L100 40 L140 340"/>';
    for(var y=80;y<340;y+=26){var k=(y-40)/300*40;h+='<path d="M'+(100-k)+' '+y+' L'+(100+k)+' '+(y+26)+' M'+(100+k)+' '+y+' L'+(100-k)+' '+(y+26)+'"/>'}
    h+='</g><circle cx="100" cy="36" r="5" fill="#D71920"><animate attributeName="opacity" values="1;.2;1" dur="1.1s" repeatCount="indefinite"/></circle>';
    for(var r=1;r<=3;r++)h+='<circle cx="100" cy="36" r="'+(r*22)+'" fill="none" stroke="#D71920" stroke-width="1.5" opacity="0"><animate attributeName="r" values="6;'+(70+r*10)+'" dur="2.4s" begin="'+(r*.8)+'s" repeatCount="indefinite"/><animate attributeName="opacity" values=".9;0" dur="2.4s" begin="'+(r*.8)+'s" repeatCount="indefinite"/></circle>';
    s.innerHTML=h}


  document.querySelectorAll("form.js-order").forEach(function(f){f.addEventListener("submit",function(e){e.preventDefault();f.querySelector(".ok").hidden=false})});

  var mb=document.getElementById("menu-btn"),menu=document.getElementById("menu");
  mb.addEventListener("click",function(){var o=menu.classList.toggle("open");mb.setAttribute("aria-expanded",o)});
  var NAMES=["home","wake","music","films","lives","story","blog","vault","work","projects","connect","support","privacy"];
  function route(){var h=(location.hash||"").slice(1),target=null;
    if(h==="thread"){target="thread";h="home"}
    if(h.indexOf("blog/")===0){target="e-"+h.slice(5);h="blog";var de=document.getElementById(target);if(de)de.open=true}
    if(NAMES.indexOf(h)<0)h="home";
    document.querySelectorAll(".view").forEach(function(v){v.hidden=v.dataset.view!==h});
    menu.querySelectorAll("a").forEach(function(a){a.getAttribute("href")==="#"+h?a.setAttribute("aria-current","page"):a.removeAttribute("aria-current")});
    menu.classList.remove("open");mb.setAttribute("aria-expanded","false");
    window.dispatchEvent(new Event("resize"));
    if(target){var el=document.getElementById(target);if(el)el.scrollIntoView()}else window.scrollTo(0,0)}
  window.addEventListener("hashchange",route);route();
})();
</script>
