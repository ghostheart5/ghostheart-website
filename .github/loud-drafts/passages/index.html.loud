<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="canonical" href="https://www.myghostheart.com/passages/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="GhostHeart">
<meta property="og:title" content="Passages | GhostHeart">
<meta property="og:description" content="The GhostHeart story in short pieces, a new one every Sunday.">
<meta property="og:url" content="https://www.myghostheart.com/passages/">
<meta property="og:image" content="https://www.myghostheart.com/assets/story/ghostheart-awakening-banner.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="description" content="Passages: the GhostHeart story in short pieces, a new one every Sunday.">
<title>Passages | GhostHeart</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Permanent+Marker&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/loud/loud.css">
<style>
.pg-hero{position:relative;padding:150px clamp(16px,4vw,48px) 70px;overflow:hidden;isolation:isolate;background:radial-gradient(100% 90% at 85% 10%,#3a0008,var(--void) 60%)}
.pg-hero .giant{position:absolute;z-index:-1;right:-3vw;bottom:-4vw;font-size:22vw;color:transparent;-webkit-text-stroke:2px rgba(232,0,28,.28);white-space:nowrap}
.pg-hero h1{font-size:clamp(80px,14vw,230px);margin-top:18px}
.pg-hero h1 .r{color:var(--blood);display:inline-block;text-shadow:3px 0 var(--glitch),-3px 0 var(--hot);animation:glitch 3.2s infinite steps(1)}
.pg-hero .tag{max-width:640px}
.next-drop{display:inline-flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:10px;background:var(--bone);color:var(--void);padding:14px 18px;font-weight:700;letter-spacing:.06em;transform:rotate(-1deg)}
.next-drop b{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:28px;letter-spacing:.02em;color:var(--blood)}

.list{display:grid;gap:18px}
.p{display:grid;grid-template-columns:clamp(90px,12vw,170px) 1fr auto;gap:clamp(14px,3vw,36px);align-items:center;padding:clamp(18px,2.5vw,30px);border:3px solid #262626;background:#0b0b0b;transition:.14s;text-align:left;width:100%}
@media(max-width:700px){.p{grid-template-columns:1fr}}
.p .no{font-family:Anton,Impact,sans-serif;font-size:clamp(70px,9vw,140px);line-height:.8;color:transparent;-webkit-text-stroke:2px var(--blood)}
.p .meta{font-weight:700;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--ash)}
.p .meta .live{color:var(--hot)}
.p h2{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:clamp(40px,5vw,78px);line-height:.88;text-transform:uppercase;margin:8px 0}
.p .tease{font-family:"Permanent Marker",cursive;font-size:clamp(18px,2vw,24px);color:#d8d4cc}
.p .act{font-family:Anton,Impact,sans-serif;font-size:22px;text-transform:uppercase;padding:14px 20px;border:3px solid var(--blood);color:var(--blood);white-space:nowrap}
.p.open{cursor:pointer}
.p.open:hover{border-color:var(--blood);transform:translate(-4px,-4px);box-shadow:8px 8px 0 var(--blood)}
.p.open:hover .no{color:var(--blood)}
.p.open:hover .act{background:var(--blood);color:var(--void)}
.p.locked{opacity:.75}
.p.locked .act{border-color:#444;color:var(--ash)}
.p.latest{border-color:var(--blood)}
.p.latest .act{background:var(--blood);color:var(--void)}

.how{background:var(--bone);color:var(--void)}
.how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:4px solid var(--void);border-left:4px solid var(--void)}
@media(max-width:800px){.how-grid{grid-template-columns:1fr}}
.how-grid div{padding:26px;border-right:4px solid var(--void);border-bottom:4px solid var(--void)}
.how-grid b{display:block;font-family:Anton,Impact,sans-serif;font-weight:400;font-size:clamp(34px,3.6vw,52px);text-transform:uppercase;line-height:.9;margin-bottom:10px}
.how-grid p{font-size:18px}

/* reader */
.reader{position:fixed;inset:0;z-index:97;background:var(--void);overflow-y:auto;display:none}
.reader.on{display:block}
.reader .bar{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px clamp(16px,4vw,48px);background:var(--void);border-bottom:4px solid var(--blood)}
.reader .bar span{font-weight:700;letter-spacing:.2em;font-size:12px;text-transform:uppercase;color:var(--ash)}
.reader .close{font-family:Anton,Impact,sans-serif;font-size:22px;text-transform:uppercase;padding:10px 16px;border:2px solid var(--bone)}
.reader .close:hover{background:var(--bone);color:var(--void)}
.reader .prog{position:absolute;left:0;bottom:-4px;height:4px;width:0;background:var(--bone)}
.r-head{padding:clamp(50px,7vw,90px) clamp(16px,4vw,48px) 30px;max-width:1000px;margin:0 auto}
.r-head .no{font-family:Anton,Impact,sans-serif;font-size:clamp(90px,12vw,180px);line-height:.8;color:var(--blood)}
.r-head h2{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:clamp(56px,8vw,120px);line-height:.88;text-transform:uppercase;margin-top:10px}
.r-head .meta{margin-top:16px;font-weight:700;letter-spacing:.2em;font-size:12px;text-transform:uppercase;color:var(--ash)}
.r-body{max-width:720px;margin:0 auto;padding:0 clamp(16px,4vw,48px) 40px;font-size:clamp(19px,1.6vw,22px);line-height:1.65;color:#e6e2da}
.r-body p{margin-bottom:1.1em}
.r-body .pull{margin:1.4em 0;padding:24px 22px;background:var(--blood);color:var(--void);font-family:Anton,Impact,sans-serif;text-transform:uppercase;font-size:clamp(34px,4.4vw,60px);line-height:.9;transform:rotate(-1deg)}
.r-end{max-width:720px;margin:0 auto 90px;padding:0 clamp(16px,4vw,48px)}
.r-end .pair{display:flex;flex-wrap:wrap;align-items:center;gap:16px;background:#0f0f0f;border:3px solid #262626;padding:20px}
.r-end .pair small{display:block;font-weight:700;letter-spacing:.2em;font-size:11px;color:var(--ash);text-transform:uppercase}
.r-end .pair strong{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:30px;text-transform:uppercase}
.r-end .pair button{width:64px;height:64px;border-radius:50%;background:var(--blood);color:var(--void);font-size:22px;animation:heart 1.1s infinite}
.r-end .nextup{margin-top:22px;display:flex;flex-wrap:wrap;gap:12px}
.sitefoot{display:block;padding:50px max(16px,4vw) 110px;border-top:4px solid var(--blood);background:var(--void);color:var(--bone);text-transform:none;letter-spacing:0;font-size:15px}
.sitefoot .fcols{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:30px}
@media(max-width:800px){.sitefoot .fcols{grid-template-columns:1fr 1fr}}
.sitefoot b{font-family:Anton,Impact,sans-serif;font-weight:400;font-size:34px}.sitefoot b i{font-style:normal;color:var(--blood)}
.sitefoot p{color:var(--ash);margin-top:8px}
.sitefoot nav{display:flex;flex-direction:column;gap:8px}
.sitefoot nav span{font-weight:700;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--ash)}
.sitefoot nav a:hover{color:var(--hot)}
.sitefoot .fcopy{margin-top:34px;font-size:12px;letter-spacing:.15em;text-transform:uppercase}
</style>
</head>
<body>
<!--@inject-from live/index.html header.ghx-header-->

<header class="pg-hero">
  <div class="giant display">PASSAGES</div>
  <span class="kicker">✶ The story, one piece at a time</span>
  <h1 class="display">Pass<span class="r">ages.</span></h1>
  <p class="tag">Short pieces of the story. A few minutes each. A new one drops every Sunday.</p>
  <div class="next-drop" id="nextDrop"></div>
</header>

<section style="padding-top:60px">
  <div class="label"><span>Every Passage / newest first</span><span class="num" id="countNum">04</span></div>
  <div class="list" id="list"></div>
  <noscript><span id="p01"></span><span id="p02"></span><span id="p03"></span><span id="p04"></span><p>Turn on JavaScript to read the Passages.</p></noscript>
</section>

<section class="how">
  <div class="label"><span>How Passages work</span><span class="num">✶</span></div>
  <div class="how-grid">
    <div><b>Short.</b><p>Each one takes a few minutes. Read it on a break.</p></div>
    <div><b>Every Sunday.</b><p>A new Passage unlocks each Sunday. Come back to keep going.</p></div>
    <div><b>Paired.</b><p>Every Passage comes with the song that belongs to it.</p></div>
  </div>
  <p style="margin-top:30px;font-weight:700;max-width:720px">Some parts of the story are hard to hear. You can pause, step away, or skip a Passage. You don't owe anyone your pain.</p>
</section>

<footer class="sitefoot">
  <div class="fcols">
    <div><b>GHOST<i>HEART</i></b><p>Real stories. Real people. Same heart.</p></div>
    <nav aria-label="Listen and watch"><span>Listen &amp; watch</span><a href="/music/">Music</a><a href="/GhostHeart_Videos.html">Films</a><a href="/live/">Live</a></nav>
    <nav aria-label="Read"><span>Read</span><a href="/passages/">Passages</a><a href="/GhostHeart_Story.html">The Story</a><a href="/journal/">Blog</a><a href="/GhostHeart_Quotes.html">Quote Vault</a></nav>
    <nav aria-label="Stay"><span>Stay</span><a href="/vault/">The Vault</a><a href="/follow/">Stay Connected</a><a href="/GhostHeart_Resources.html">Help &amp; Resources</a><a href="/GhostHeart_Privacy.html">Privacy</a></nav>
  </div>
  <p class="fcopy">© 2026 GhostHeart Studios</p>
</footer>

<div class="reader" id="reader" role="dialog" aria-modal="true" aria-labelledby="rTitle">
  <div class="bar"><span id="rBar">Passage</span><button class="close" id="rClose">Close ✕</button><i class="prog" id="rProg"></i></div>
  <div class="r-head"><div class="no" id="rNo"></div><h2 id="rTitle"></h2><div class="meta" id="rMeta"></div></div>
  <div class="r-body" id="rBody"></div>
  <div class="r-end">
    <div class="pair"><button id="rPlay" aria-label="Play the paired song">▶</button><div><small>The song for this Passage</small><strong id="rSong"></strong></div></div>
    <div class="nextup" id="rNext"></div>
  </div>
</div>
<audio id="aud" preload="none"></audio>

<script>
// Proposed schedule: Passage 01 on the Sunday Lives start date the owner set (Oct 11, 2026), then one each Sunday.
const P=[
 {n:'01',title:'My Promise',date:'2026-10-11',song:['GhostHeart’s Oath','awakening-06-ghosthearts-oath.mp3'],tease:'Before I share more of my story, I want you to know what I’m promising you.',body:[
  'Before I share more of my story, I want you to know what I’m promising you.',
  'I’m not perfect. I’m learning every day how to use my voice, social media and the things I’m building to do some good. Sometimes I’ll get it wrong. Sometimes the words won’t come out the way I meant them. Bear with me. I’ll listen, take responsibility and keep learning. I don’t have everything figured out, but I care enough to keep trying.',
  'I’m not here to call people out or build myself up by bringing somebody else down. My story includes people I love, people I’ve hurt, and people who have hurt me. Telling it honestly means owning my part, too. It doesn’t mean turning anyone into a target or asking you to take sides. I want to tell the truth with care, knowing that other people have stories of their own.',
  'To my family: you will always be part of my journey. That doesn’t mean every part of our lives belongs in public. Some things belong to us, and I promise to protect that.',
  'To my children: I want you to know there are good people in this world. People who show up, who listen, who help without needing applause. I promise to keep showing you that goodness—and to work on being someone who shows it through his own actions.',
  'To my wife: I promise to keep walking beside you and caring for the life we share. Your love gives me strength to speak when I’m afraid and keep going when I doubt myself. As I reach toward other people, I won’t forget the person beside me. Whatever grows from this, you are part of the heart that made it possible.',
  '>And to anyone finding their way here: this welcome includes you.',
  'Every race. Every person in the LGBTQ+ community. Rich or poor. Certain of who you are or still figuring it out. Whether you stay for a while or you’re only passing through, you deserve to be treated with dignity.',
  'I won’t reduce you to a label or decide your whole worth from a distance. Compassion and accountability can exist together. We can make room for people while still taking responsibility for the harm we cause.',
  'I promise that money and growth will never be worth more to me than people. I want this work to succeed, but I won’t measure that success only by what it earns. I want to care about what it gives, how it treats people and whether I can stand behind it honestly.',
  'I’ll help where I can. And I’ll be honest about my limits. I’m sharing my experience; I’m not a replacement for a therapist, counselor or mental health provider.',
  'Some parts of my story will be difficult to hear. I’ll give you clear warnings when we reach those subjects. You can pause, step away or decide a reading isn’t for you. You don’t owe me your pain, your personal details or your attention at the expense of your well-being.',
  'If you come back, I hope you find honesty here. Something to think about. A little courage. A reminder that people can struggle, make mistakes, learn and still choose to do good.',
  'There’s more I want to share, and I want to share it with care. For today, this is where I begin: with a promise to keep learning, keep listening and keep choosing the kind of person I want this work to reflect.',
  '>Thank you for being here. You’re welcome to come back exactly as you are.']},
 {n:'02',title:'I Kept Saying It',date:'2026-10-18',song:['Cruel','awakening-01-cruel.mp3'],tease:'I kept seeing people treated like they were nothing.',body:[
  'I kept seeing people treated like they were nothing.',
  'People without a home being picked on. People struggling with addiction being laughed at. LGBTQ people getting torn apart for existing. Mental illness turned into a joke. Everybody pointing a finger while somebody else stood there taking the damage.',
  'And I had plenty to say about it.',
  'If I’d been there, I would’ve said something. I would’ve stood up for them. I’d find time to help at a shelter. Make a stand. Do something that mattered.',
  'I kept saying it.',
  'I got angry at the news, the schools, the government. Why the hell was this happening? Why was it allowed? People were supposed to be protected. Every one of them.',
  '>But I wasn’t doing shit about it.']},
 {n:'03',title:'Afraid to Be Seen',date:'2026-10-25',song:['I’m Not','awakening-02-im-not-staying-silent.mp3'],tease:'My faults. My past. Everything they could pick apart.',body:[
  'That was hard to admit, because I really did care. I cared enough to get angry. Enough to hurt over it. But stepping forward meant giving people a reason to look at me.',
  '>My faults. My past. Everything they could pick apart.',
  'There’s a lot in my life somebody could judge. There are also choices I have to own. What happened to me doesn’t erase my responsibility for what I’ve done. Telling my story means being honest about that, too.',
  'I was afraid of being ridiculed. Afraid of starting fights. Afraid that trying to help somebody else would give the world another chance to tear me down.',
  'So I sat there, caring, hurting, and complaining.',
  'Eventually, I had to face how little that was changing.']},
 {n:'04',title:'A Way to Hide',date:'2026-11-01',song:['This Is GhostHeart','awakening-05-this-is-ghostheart.mp3'],tease:'A way to hide and still tell my story.',body:[
  'My first idea was a website where people could write how they felt. Looking back, I thought it was dumb. I spent a year struggling to build apps and figure out social media, failing at things I wanted so badly to get right.',
  'Then I finished Axiomara. And I came up with GhostHeart.',
  '>A way to hide and still tell my story.',
  'GhostHeart carries the bravery, the strength, the courage I’m still trying to find in myself. He gives me a way to step forward while part of me still wants to stay hidden.',
  'I’m the man behind him. The one who cares deeply and is still scared.',
  'That’s where the awakening began: admitting that I could spend my life being angry about people’s pain without ever doing anything useful with my own.',
  'Maybe my story could help somebody. Even with the ugly parts. Even with the mistakes I have to own. Even if the world judged me for telling it.',
  'I don’t know how many people will read these words. I don’t know if I’ll ever stop being afraid of what comes next.',
  '>But if I help one person, then I did something.',
  'I finally did more than sit there and wish somebody would.']}
];
const fmt=d=>new Date(d+'T12:00:00').toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',year:'numeric'});
const today=new Date();const ymd=today.getFullYear()+'-'+String(today.getMonth()+1).padStart(2,'0')+'-'+String(today.getDate()).padStart(2,'0');
const isOpen=p=>p.date<=ymd;
const words=p=>p.body.join(' ').split(/\s+/).length, mins=p=>Math.max(1,Math.round(words(p)/200));
const open=P.filter(isOpen), latest=open[open.length-1], next=P.find(p=>!isOpen(p));
document.getElementById('nextDrop').innerHTML=next?`NEXT PASSAGE <b>${next.n} · ${next.title}</b> DROPS ${fmt(next.date).toUpperCase()}`:`<b>ALL CAUGHT UP</b> NEW PASSAGES COMING`;
document.getElementById('countNum').textContent=String(P.length).padStart(2,'0');
const list=document.getElementById('list');
[...P].reverse().forEach(p=>{const o=isOpen(p);const el=document.createElement(o?'button':'div');
 el.id='p'+p.n;el.className='p '+(o?'open':'locked')+(p===latest?' latest':'');
 if(o){el.type='button';el.addEventListener('click',()=>read(p))}
 el.innerHTML=`<span class="no">${p.n}</span><div><div class="meta">${o?`<span class="live">${p===latest?'NEW · ':''}OUT NOW</span> · ${fmt(p.date)} · ${mins(p)} MIN READ`:`DROPS ${fmt(p.date)}`}</div><h2>${p.title}</h2><p class="tease">${p.tease}</p></div><span class="act">${o?'Read ↗':'🔒 '+fmt(p.date).split(',').slice(0,2).join(',')}</span>`;
 list.appendChild(el)});
// reader
const R=document.getElementById('reader'),aud=document.getElementById('aud');let cur=null;
function read(p){cur=p;document.getElementById('rBar').textContent='Passage '+p.n+' · '+fmt(p.date);
 document.getElementById('rNo').textContent=p.n;document.getElementById('rTitle').textContent=p.title;
 document.getElementById('rMeta').textContent=fmt(p.date)+' · '+mins(p)+' min read';
 document.getElementById('rBody').innerHTML=p.body.map(t=>t.startsWith('>')?`<p class="pull">${t.slice(1)}</p>`:`<p>${t}</p>`).join('');
 document.getElementById('rSong').textContent=p.song[0];aud.pause();document.getElementById('rPlay').textContent='▶';
 const i=P.indexOf(p),nx=P[i+1],pv=P[i-1];
 document.getElementById('rNext').innerHTML=(pv?`<button class="btn ghost" data-go="${i-1}">← Passage ${pv.n}</button>`:'')+(nx?(isOpen(nx)?`<button class="btn red" data-go="${i+1}">Passage ${nx.n} →</button>`:`<span class="btn ghost" style="opacity:.7">Passage ${nx.n} drops ${fmt(nx.date)}</span>`):'');
 document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>read(P[+b.dataset.go]));
 R.classList.add('on');R.scrollTop=0;document.body.style.overflow='hidden';try{history.replaceState(null,'','#p'+p.n)}catch(e){}
 document.getElementById('rClose').focus()}
function close(){R.classList.remove('on');document.body.style.overflow='';aud.pause();try{history.replaceState(null,'','#')}catch(e){}}
document.getElementById('rClose').onclick=close;addEventListener('keydown',e=>{if(e.key==='Escape'&&R.classList.contains('on'))close()});
R.addEventListener('scroll',()=>{const m=R.scrollHeight-R.clientHeight;document.getElementById('rProg').style.width=(m>0?R.scrollTop/m*100:0)+'%'});
document.getElementById('rPlay').onclick=()=>{if(!cur)return;const src='/assets/music/preview/'+cur.song[1];if(!aud.src.endsWith(src))aud.src=src;if(aud.paused){aud.play().catch(()=>{});document.getElementById('rPlay').textContent='❚❚'}else{aud.pause();document.getElementById('rPlay').textContent='▶'}};
const h=location.hash.match(/^#p(\d\d)$/);if(h){const p=P.find(x=>x.n===h[1]);if(p&&isOpen(p))read(p)}
</script>
<script src="/assets/shared/ghostheart-world.js"></script>
<script src="/assets/loud/loud.js"></script>
</body>
</html>
